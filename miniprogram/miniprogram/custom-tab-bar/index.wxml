<!-- 自定义底部 Tab 栏（2026-09-10：胶囊样式，与首页/任务地图/战况统一；由框架常驻，切页不重绘） -->
<view class="tabbar">
  <view class="tb {{selected === index ? 'on' : ''}}" wx:for="{{tabs}}" wx:key="key" data-i="{{index}}" bindtap="onTap">
    <view class="pill">
      <view class="tic">{{item.ic}}</view>
      <text>{{item.label}}</text>
    </view>
  </view>
  <!-- 2026-09-28 老板定：栏尾「退出」—— **只在游客身份显示**（正式业务员、老板都不显示）
       ⚠️ 图标用**文字符号** ⏏（U+23CF），不要用 emoji —— emoji 是彩色的、color 管不住（项目规矩） -->
  <view class="tb tb-out" wx:if="{{isTrial}}" bindtap="onLogout">
    <view class="pill">
      <text>⏏ 退出</text>
    </view>
  </view>
</view>
