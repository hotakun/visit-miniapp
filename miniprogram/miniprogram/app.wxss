/* 聚火拜访 · 全局样式（聚火橙设计规范 v0.6） */
page {
  --primary: #F5531C;
  --primary-deep: #D93E0E;
  --primary-tint: #FFEDE5;
  --green: #16A34A;
  --green-tint: #E7F6EC;
  --blue: #2F80ED;
  --blue-tint: #E8F1FD;
  --warn: #F5A623;
  --warn-tint: #FDF3E2;
  --danger: #E5484D;
  --bg: #F6F7F9;
  --card: #FFFFFF;
  --ink: #1F2430;
  --sub: #66707A;
  --line: #EEF0F3;
  background: var(--bg);
  color: var(--ink);
  font-family: "MiSans", "HarmonyOS Sans SC", "PingFang SC", "Microsoft YaHei UI", sans-serif;
  font-size: 15px;
}

.btn-primary {
  height: 52px;
  border-radius: 14px;
  background: linear-gradient(135deg, #FF7A3D, #F5531C);
  color: #fff;
  font-size: 17px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  box-shadow: 0 8px 20px rgba(245, 83, 28, 0.32);
  letter-spacing: 1px;
}

.card {
  background: var(--card);
  border-radius: 16px;
  box-shadow: 0 2px 10px rgba(31, 36, 48, 0.06);
}
