<!-- 登录 / 注册（2026-09-09 老板拍板：注册申请 → 后台审核 → 通过后免登录进入） -->
<view class="page" wx:if="{{!user}}">
  <!-- 品牌区（2026-09-28 按老板确认的 HTML 预览稿改版：LOGO 放大、居中、下方一道品牌短线） -->
  <view class="brand">
    <image class="logo" src="{{logoUrl}}" mode="aspectFit" binderror="onLogoError"></image>
    <view class="name">聚火拜访</view>
    <view class="sub">客户回访 · 新客开发</view>
    <view class="brand-line"></view>
  </view>

  <!-- 开发者三身份选择页（2026-09-09 双身份 → 2026-09-28 三身份，加「游客」；只有范宇琨的微信可见） -->
  <view class="dev-card" wx:if="{{devMode}}">
    <view class="dc-t">{{devTitle}}</view>
    <view class="dc-d"><text>{{devDesc}}</text></view>
    <view class="btn-primary" style="margin-top:20px" bindtap="enterAsSalesman">🏃 以业务员身份进入</view>
    <view class="btn-boss" bindtap="enterAsBoss">👑 以老板身份进入</view>
    <!-- 2026-09-28 老板定：加第三个 —— 以游客（trial）身份进入，体验与真实游客完全一致（能看、不能提交） -->
    <view class="btn-trial" bindtap="enterAsGuest">🖐 以游客身份进入（只读体验）</view>
  </view>

  <view class="adminTip" wx:elif="{{adminMode}}">
    <view class="at">👑 管理员模式</view>
    <view class="atd">您已识别为超级管理员「{{adminName}}」</view>
    <view class="atd">管理功能请使用 Web 管理后台（浏览器登录 qingyan）</view>
    <view class="atd">本小程序为业务员专用版</view>
    <view class="btn-primary" style="margin-top:16px" wx:if="{{canBoss}}" bindtap="enterBoss">👑 进入老板模式（演示）</view>
    <view class="btn-primary" style="margin-top:10px;background:#F6F7F9;color:var(--ink)" bindtap="refresh">刷新身份</view>
  </view>

  <!-- 注册表单（2026-09-09 老板拍板：姓名+手机号 → 后台审核）
       2026-09-28 按老板确认的 HTML 预览稿 v3（_scratch/游客入口-完整流程-预览.html）落地：
       ① 「验证」两个字保留，与「手机号 *」同排，位置正好在「快捷录入」方形按钮的正上方
       ② 上方留出约 1/3 屏给 LOGO 与文字（品牌区 225px），输入面板整体下移
       ③ 审核说明：**一句话一行**「提交管理员审核，通过后重开小程序即可直接进入」
          （2026-09-28 老板改；⚠️ 别再写成"在这里换行"）
       ④ 入口：去掉手图标、按钮收小、副文案「免注册」并入按钮内；文案 =「实习体验入口」 -->
  <block wx:elif="{{registerMode}}">
    <!-- 2026-09-28 老板定：提示两行 —— ⚠️ **必须写成两个 view**！
         wxml 里的"真换行"会被小程序编译压成空格（跟 HTML 一样），white-space:pre-line 拿不到 \n，
         所以手机上会变成一行（演示稿 HTML 里用 <br> 是好的、真机不对，2026-09-28 真机验证过）。
         2026-09-28 老板改：首行「首次使用」→「**正式使用**」（有人第一次来只是实习体验，不算"首次使用"） -->
    <view class="tip">
      <view>正式使用请注册</view>
      <view>仅供聚火城市配送公司内部使用</view>
    </view>
    <view class="reg-card">
      <view class="frow">
        <label>姓名 *</label>
        <input class="inp" style="margin-top:5px" value="{{name}}" bindinput="onName" placeholder="真实姓名" placeholder-style="color:#9AA3AE" />
      </view>

      <view class="frow" style="margin-bottom:0">
        <view class="lb-row">
          <label class="c1">手机号 *</label>
          <label class="c2">验证</label>
        </view>
        <view class="phone-row">
          <input class="inp" type="number" maxlength="11" value="{{phone}}" bindinput="onPhone" placeholder="11 位手机号" placeholder-style="color:#9AA3AE" />
          <!-- ⚠️ 微信 button 在 flex 里"不吃" width:auto（它默认块级 + 自带 margin:auto，很倔）。
               标准做法：外面套一个 view 当 flex item（view 宽度天然由内容决定），button 在里面 width:100% 跟着走。 -->
          <view class="quick-wrap">
            <button class="btn-quick {{phoneVerified ? 'ok' : ''}}" open-type="getPhoneNumber" bindgetphonenumber="onGetPhone" disabled="{{phoneVerified}}">
              {{phoneVerified ? '已验证' : '快捷录入'}}
            </button>
          </view>
        </view>
      </view>

      <!-- 2026-09-28 老板定：手机号行与按钮行之间加一条**很淡的分割线**（居中、两端渐隐） -->
      <view class="sep"></view>

      <!-- 2026-09-28 老板定：这一行做成**两个按钮** —— 左边「取消申请」、右边「提交申请」
           取消 = 放弃本次注册：清掉已填/已验证的手机号 + 撤回云端待审核申请（若有）+ 清本地标记、重进登录页 -->
      <view class="btn-row2">
        <view class="btn-cancel" bindtap="cancelReg">取消申请</view>
        <view class="btn-primary" bindtap="submitReg">{{regBusy ? '提交中…' : '提交申请'}}</view>
      </view>
      <!-- 2026-09-28 老板定：文案改成**一句话一行**（不再换行 → 也就绕开了"wxml 真换行会被编译压掉"那个坑） -->
      <view class="reg-note">提交管理员审核，通过后重开小程序即可直接进入</view>
    </view>
    <!-- 2026-09-27 老板定：恢复实习（trial）体验入口；只读，云端硬拦提交。
         2026-09-28 老板定：文案「实习体验入口」（原「游客」已改），副文案只留「（免注册）」并入按钮内。 -->
    <view class="trial-zone">
      <view class="trial-link" wx:if="{{trialId}}" bindtap="enterTrial">实习体验入口<text class="lite">（免注册）</text></view>
    </view>
  </block>

  <!-- 审核中 -->
  <block wx:elif="{{pendingMode}}">
    <view class="state-card">
      <view class="sc-ic">⏳</view>
      <view class="sc-t">申请已提交，等待审核</view>
      <view class="sc-d"><text>提交时间：{{pendingAt}}\n管理员审核通过后，重新打开小程序即可使用</text></view>
      <view class="btn-primary" style="margin-top:20px;background:#F6F7F9;color:var(--ink)" bindtap="refresh">🔄 刷新状态</view>
    </view>
  </block>

  <!-- 被拒绝（可重新申请，2026-09-09 老板拍板） -->
  <block wx:elif="{{rejectedMode}}">
    <view class="state-card">
      <view class="sc-ic">✗</view>
      <view class="sc-t">申请未通过</view>
      <view class="sc-d" wx:if="{{rejectReason}}">原因：{{rejectReason}}</view>
      <view class="btn-primary" style="margin-top:20px" bindtap="reapply">重新申请</view>
    </view>
  </block>

  <view class="loading" wx:else>正在识别身份…</view>
</view>
