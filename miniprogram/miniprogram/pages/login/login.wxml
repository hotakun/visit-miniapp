<!-- 登录 / 首次绑定 -->
<view class="page" wx:if="{{!user}}">
  <view class="hero">
    <image class="logo" src="{{logoUrl}}" mode="aspectFit" binderror="onLogoError"></image>
    <view class="name">聚火拜访</view>
    <view class="sub">客户回访 · 新客开发</view>
  </view>

  <view class="adminTip" wx:if="{{adminMode}}">
    <view class="at">👑 管理员模式</view>
    <view class="atd">您已识别为超级管理员「{{adminName}}」</view>
    <view class="atd">管理功能请使用 Web 管理后台（浏览器登录 qingyan）</view>
    <view class="atd">本小程序为业务员专用版</view>
    <view class="btn-primary" style="margin-top:16px" bindtap="refresh">刷新身份</view>
  </view>

  <block wx:elif="{{binding}}">
    <view class="trial-banner" wx:if="{{hasTrial}}">🖐 游客体验：点击「实习」即可直接登录体验（无需真实身份，供审核/演示）</view>
    <view class="tip">首次使用，请选择你的姓名完成微信绑定</view>
    <view class="sman-list">
      <view class="sman {{item.trial ? 'trial' : ''}}" wx:for="{{salesmen}}" wx:key="_id" bindtap="bind" data-id="{{item._id}}">
        <view class="av">{{item.name[0]}}</view>
        <view class="info">
          <view class="nm">{{item.name}}<text wx:if="{{item.trial}}" class="tag">游客</text></view>
          <view class="ph">{{item.phone}}</view>
        </view>
        <view class="go">绑定 →</view>
      </view>
    </view>
    <view class="empty" wx:if="{{!salesmen.length}}">暂无待绑定业务员，请联系管理员卿燕在后台添加</view>
  </block>

  <view class="loading" wx:else>正在识别微信身份…</view>
</view>
