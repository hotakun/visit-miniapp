<!-- 登录 / 注册（2026-09-09 老板拍板：注册申请 → 后台审核 → 通过后免登录进入） -->
<view class="page" wx:if="{{!user}}">
  <view class="hero">
    <image class="logo" src="{{logoUrl}}" mode="aspectFit" binderror="onLogoError"></image>
    <view class="name">聚火拜访</view>
    <view class="sub">客户回访 · 新客开发</view>
  </view>

  <view class="adminTip" wx:if="{{adminMode}}">
    <view class="at">👑 管理员模式</view>
    <view class="atd">您已识别为超级管理员「{{adminName}}」</view>
    <view class="atd">管理功能请使用 Web 管理后台（浏览器登录 qingyan）</view>
    <view class="atd">本小程序为业务员专用版</view>
    <view class="btn-primary" style="margin-top:16px" wx:if="{{canBoss}}" bindtap="enterBoss">👑 进入老板模式（演示）</view>
    <view class="btn-primary" style="margin-top:10px;background:#F6F7F9;color:var(--ink)" bindtap="refresh">刷新身份</view>
  </view>

  <!-- 注册表单（2026-09-09 老板拍板：姓名+手机号 → 后台审核） -->
  <block wx:elif="{{registerMode}}">
    <view class="tip">首次使用，请注册您的信息</view>
    <view class="reg-card">
      <view class="frow"><label>姓名 *</label><input class="inp" value="{{name}}" bindinput="onName" placeholder="例：张三" /></view>
      <view class="frow"><label>手机号 *</label><input class="inp" type="number" maxlength="11" value="{{phone}}" bindinput="onPhone" placeholder="11 位手机号" /></view>
      <view class="frow">
        <label>验证</label>
        <button class="btn-phone-v {{phoneVerified ? 'ok' : ''}}" open-type="getPhoneNumber" bindgetphonenumber="onGetPhone" disabled="{{phoneVerified}}">
          {{phoneVerified ? '✓ 已验证' : '📱 微信一键验证'}}
        </button>
        <text class="pv-hint">微信发送验证码短信到您的手机，确认后自动填入</text>
      </view>
      <view class="btn-primary" style="margin-top:20px" bindtap="submitReg">{{regBusy ? '提交中…' : '提交申请'}}</view>
      <view class="reg-note">提交后由管理员审核，通过后重新打开小程序即可直接进入</view>
    </view>
    <view class="trial-link" wx:if="{{trialId}}" bindtap="enterTrial">🖐 游客体验入口（审核/演示用）</view>
  </block>

  <!-- 审核中 -->
  <block wx:elif="{{pendingMode}}">
    <view class="state-card">
      <view class="sc-ic">⏳</view>
      <view class="sc-t">申请已提交，等待审核</view>
      <view class="sc-d"><text>提交时间：{{pendingAt}}\n管理员审核通过后，重新打开小程序即可使用</text></view>
      <view class="btn-primary" style="margin-top:20px;background:#F6F7F9;color:var(--ink)" bindtap="refresh">🔄 刷新状态</view>
    </view>
  </block>

  <!-- 被拒绝（可重新申请，2026-09-09 老板拍板） -->
  <block wx:elif="{{rejectedMode}}">
    <view class="state-card">
      <view class="sc-ic">✗</view>
      <view class="sc-t">申请未通过</view>
      <view class="sc-d" wx:if="{{rejectReason}}">原因：{{rejectReason}}</view>
      <view class="btn-primary" style="margin-top:20px" bindtap="reapply">重新申请</view>
    </view>
  </block>

  <view class="loading" wx:else>正在识别微信身份…</view>
</view>
