<!-- 我的（业务员版 + 老板模式 2026-09-09 §7.13） -->
<view class="page">
  <!-- 老板模式：老板身份卡 -->
  <view class="profile card" wx:if="{{bossMode}}">
    <view class="avatar boss">👑</view>
    <view>
      <view class="nm">老板</view>
      <view class="rl">老板模式 · 全量查看 / 演示操作（不保存）</view>
    </view>
  </view>
  <view class="profile card" wx:else>
    <view class="avatar">{{user.name[0]}}</view>
    <view>
      <view class="nm">{{user.name}}</view>
      <view class="rl">业务员 · 聚火拜访</view>
    </view>
  </view>

  <view class="stats card" wx:if="{{!bossMode}}">
    <view class="s"><view class="v">{{stats.monthCount}}</view><view class="k">本月拜访</view></view>
    <view class="s"><view class="v">{{stats.monthCust}}</view><view class="k">本月拜访客户</view></view>
    <view class="s"><view class="v">{{stats.taskRate}}%</view><view class="k">任务完成率</view></view>
  </view>

  <view class="menu card">
    <block wx:if="{{bossMode}}">
      <view class="mi" bindtap="exitBoss"><view class="ic" style="background:#FFF0ED">🚪</view>退出老板模式<view class="arrow">›</view></view>
      <view class="mi" bindtap="tapAbout"><view class="ic" style="background:#EFF1F4">ℹ️</view>关于聚火拜访<view class="arrow">›</view></view>
    </block>
    <block wx:else>
      <view class="mi" bindtap="subscribe">
        <view class="ic" style="background:var(--primary-tint)">🔔</view>新任务提醒<text wx:if="{{mpBound}}" style="font-size:11px;color:#18A058;font-weight:700;margin-left:6px">服务号已开通</text>
        <view class="sw {{subOn ? 'on' : ''}}" id="subSwitch"></view>
      </view>
      <view class="mi" bindtap="tapSetting"><view class="ic" style="background:#EFF1F4">⚙️</view>设置<view class="arrow">›</view></view>
      <view class="mi" bindtap="tapAbout"><view class="ic" style="background:#EFF1F4">ℹ️</view>关于聚火拜访<view class="arrow">›</view></view>
      <view class="loc-note">📍 工作时段记录位置轨迹，仅管理员可见</view>
    </block>
  </view>
  <!-- 版本号（2026-09-08 老板定：内容界面左下角小灰字；双方统一口径改动才 bump） -->
  <view class="ver">v{{version}}</view>

  <!-- 老板四栏导航 -->
  <view class="tabbar" wx:if="{{bossMode}}">
    <view class="tb" bindtap="tabHome"><view class="tic">🏠</view>首页</view>
    <view class="tb" bindtap="tabMap"><view class="tic">🗺</view>任务地图</view>
    <view class="tb" bindtap="tabWar"><view class="tic">📡</view>战况</view>
    <view class="tb on"><view class="tic">👤</view>我的</view>
  </view>
  <view class="tabbar" wx:else>
    <view class="tb" bindtap="tabHome"><view class="tic">🏠</view>任务</view>
    <view class="tb" bindtap="tabMap"><view class="tic">🗺</view>地图</view>
    <view class="tb on"><view class="tic">👤</view>我的</view>
  </view>
</view>
