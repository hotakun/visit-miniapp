.page { padding: 20px 18px 110px; }
.profile { display: flex; align-items: center; gap: 14px; padding: 18px; }
.avatar { width: 58px; height: 58px; border-radius: 50%; background: linear-gradient(135deg,#FF8A50,#F5531C); color: #fff; font-size: 24px; font-weight: 800; display: flex; align-items: center; justify-content: center; }
.avatar.boss { background: linear-gradient(135deg,#3B4252,#1F2430); font-size: 26px; }
.profile .nm { font-size: 18px; font-weight: 800; }
.profile .rl { margin-top: 4px; font-size: 12.5px; color: var(--sub); font-weight: 600; }
.stats { display: flex; margin-top: 14px; padding: 16px 10px; }
.stats .s { flex: 1; text-align: center; }
.stats .v { font-size: 20px; font-weight: 800; }
.stats .k { margin-top: 4px; font-size: 11.5px; color: var(--sub); font-weight: 600; }
.menu { margin-top: 14px; padding: 4px 16px; }
.mi { display: flex; align-items: center; gap: 12px; padding: 13px 0; font-size: 14.5px; font-weight: 700; border-top: 1px solid var(--line); }
.mi:first-child { border-top: none; }
.loc-note { padding: 10px 2px 2px; font-size: 11.5px; color: var(--sub); font-weight: 400; }
.mi .ic { width: 36px; height: 36px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 16px; flex-shrink: 0; }
.mi .arrow { margin-left: auto; color: #C4CAD1; font-size: 18px; }
.sw { margin-left: auto; width: 46px; height: 26px; border-radius: 99px; background: #D5DAE0; position: relative; }
.sw::after { content: ''; position: absolute; top: 3px; left: 3px; width: 20px; height: 20px; border-radius: 50%; background: #fff; transition: left .2s; }
.sw.on { background: var(--green); }
.sw.on::after { left: 23px; }
.tabbar { position: fixed; left: 0; right: 0; bottom: 0; height: 66px; background: rgba(255,255,255,.97); display: flex; box-shadow: 0 -2px 12px rgba(31,36,48,.06); z-index: 50; }
/* 版本号（2026-09-08 老板定）：内容界面左下角小灰字（tabbar 上方、页面内容底部靠左） */
.ver { padding: 12px 4px 20px; font-size: 10px; color: #B6BEC7; font-weight: 400; text-align: left; }
.tabbar .tb { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px; font-size: 11px; color: var(--sub); font-weight: 700; }
.tabbar .tb .tic { font-size: 20px; line-height: 1; }
.tabbar .tb.on { color: var(--primary-deep); }

/* 关于聚火拜访弹层（2026-09-09 老板定：业务员/老板各自简介；右上角✕+点遮罩关闭） */
.about-mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; background: rgba(17,22,31,.55); display: flex; align-items: center; justify-content: center; z-index: 99; }
.about-card { position: relative; width: 300px; background: #fff; border-radius: 18px; padding: 22px 24px 26px; box-shadow: 0 16px 48px rgba(31,36,48,.3); }
.ac-x { position: absolute; top: 10px; right: 12px; width: 26px; height: 26px; line-height: 26px; text-align: center; color: #B6BEC7; font-size: 13px; border-radius: 50%; background: #F3F5F7; }
.ac-t { font-size: 17px; font-weight: 800; text-align: center; }
.ac-d { display: block; margin-top: 16px; font-size: 14px; line-height: 1.9; color: #333A44; text-align: center; }
