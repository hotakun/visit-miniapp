/* 更正信息页样式（2026-10-10）
   ⚠️ 表单区（卡片/行/输入框/picker/招牌菜 chips）**整套复用「加新店」的样式** ——
      直接 @import，保证两边长得一模一样（老板要求"加新店的第二页内容一样的出来"）。
      newshop.wxss 里没有 page 级选择器，只有 .page 等类选择器，@import 安全。 */
@import "../newshop/newshop.wxss";

/* 本页特有：顶部提示条 + 底部保存按钮 */
.tipbar {
  margin: 10px 12px 0;
  padding: 9px 12px;
  background: #FFF7ED;
  border: 1px solid #FDE3C8;
  border-radius: 9px;
  font-size: 12.5px;
  color: #9A5B12;
  line-height: 1.5;
}
.foot {
  flex-shrink: 0;
  padding: 10px 12px calc(10px + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1px solid #EEF1F6;
}
.savebtn {
  height: 46px;
  border-radius: 23px;
  background: linear-gradient(135deg, #F5531C, #FF7A45);
  color: #fff;
  font-size: 16px;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 1px;
}
.savebtn.busy { opacity: .6; }
