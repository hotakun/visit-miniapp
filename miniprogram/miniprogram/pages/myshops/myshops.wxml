<!-- 我新加的店（2026-09-29 新增）—— 「我的」页 → 我的记事 下面进来的
     只列**我自己**提交的现场录入（source:'field'）。
     卡片显示：店名 / 提交时间 / 提交人 / 状态（就用现成的 mallPending：待商城建档 / 已对上商城）
     ⭐ 点一下 → 用「加新店」页**预填编辑**（改完直接生效）
     ⚠️ 铁律：WXML 只用 view / text（禁 HTML 标签） -->
<view class="page">

  <view class="hd">
    <view class="hd-t">🏪 加新店</view>
    <view class="hd-s" wx:if="{{loaded}}">我加过的店 · 共 {{total}} 家</view>
    <view class="hd-s" wx:else>加载中…</view>
  </view>

  <!-- 空态 -->
  <view class="empty" wx:if="{{loaded && !list.length}}">
    <view class="e-ic">🏪</view>
    <view class="e-t">还没加过新店</view>
    <view class="e-s">点下面的「＋ 加新店」现场建档，提交后就会出现在这里，还能回来改。</view>
  </view>

  <!-- 卡片列表 -->
  <view class="shopcard" wx:for="{{list}}" wx:key="id" bindtap="openShop" data-id="{{item.id}}">
    <view class="r1">
      <text class="nm">{{item.name}}</text>
      <!-- ⭐ 2026-10-03 老板定：这张卡是「**我自己现场采集的店**」，胶囊固定显示「新店采集」。
           原来拿 mallPending 二值判断显示"待商城建档 / 已对上商城" —— 但 mallPending 的 false
           **有两种来源**：① 真导入商城表比对上了 ② 被旧的「手工已建档」点掉（那个按钮 09-29 已删，
           可历史数据留下了 false 却没写任何商城字段）→ 后者明明没对上商城，卡片却报"已对上商城"
           （老板 2026-10-03 实测报障就是这个）。
           ⚠️ "是否已对上商城"是**老板后台**关心的事（判据看 customerType==='mall' / mallKey），
              不该摆到业务员这张卡上。 -->
      <text class="st new">新店采集</text>
    </view>
    <view class="r2" wx:if="{{item.addrLine}}">{{item.addrLine}}</view>
    <view class="r3">
      <text class="t">{{item.timeText}}</text>
      <text wx:if="{{item.createdByName}}">　提交人 {{item.createdByName}}</text>
    </view>
    <view class="r4">
      <text wx:if="{{item.photoCount}}">📷 {{item.photoCount}}</text>
      <text wx:if="{{item.audioCount}}">　🎙 {{item.audioCount}}</text>
      <text class="go">点一下改内容 ›</text>
    </view>
    <!-- ⭐ 2026-10-02 老板定：卡片右边加「开始拜访」—— 建完店能立刻去拜访（走无任务拜访）
         ⚠️ 必须 catchtap（阻止冒泡），否则会同时触发卡片本身的"编辑" -->
    <!-- ⭐ 2026-10-07 老板定：这张卡的按钮从「开始拜访」改成「客户详情」——
         先看客户详情（7 张卡 + 能分享给同事），详情页最下面再「开始拜访」去拜访。
         ⚠️ 跳转带 freeVisit=1：告诉详情页"这是无任务的自由拜访"，详情页会据此清掉 storage 里可能残留的 taskId。 -->
    <view class="fv" catchtap="goDetail" data-id="{{item.id}}">客户详情</view>
  </view>

  <!-- 加载更多 -->
  <view class="more" wx:if="{{hasMore}}" bindtap="loadMore">{{loadingMore ? '加载中…' : '加载更多'}}</view>

  <view class="pad"></view>

  <!-- ⭐ 2026-10-02 老板定：**吸底固定的「＋ 加新店」** —— 位置与样式跟「我的记事」的「＋ 记一笔」
       完全一致（fixed 悬在屏幕底部；白底 + 虚线橙边橙字，不是橙色实心） -->
  <view class="newbar">
    <view class="nb-btn" bindtap="goAdd">＋ 加新店</view>
  </view>

</view>
