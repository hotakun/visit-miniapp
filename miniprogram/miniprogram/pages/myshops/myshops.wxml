<!-- 我新加的店（2026-09-29 新增）——「我的」页 → 我的记事 下面进来。
     ⭐⭐ 2026-10-15 老板定：**卡片摆放方式改成和老板端「新店」页完全一样**
         （横排卡 <缩略图 + 店名/地址/区域·商圈·录入人 + 箭头> + 搜索 + 按日期/按商圈 + 「数据截至」），
         **只是业务员端底部多一个「＋ 加新店」按钮**。
     数据仍只显示**我自己**提交的现场录入（source:'field' + createdBy=我）——
     云函数 `tasks.myNewShops` 已按 `listNewShops` 的格式返回（含 photos 归一化 / since 增量 / maxAt）。
     点卡片 → 客户详情页（必须带 ?id=，页面身份只认 URL 那条铁律）。
     ⚠️ 铁律：WXML 只用 view / text（禁 HTML 标签） -->
<view class="page">
  <view class="bar">
    <view class="sbox">
      <text class="ico">🔍</text>
      <input class="sin" value="{{kw}}" bindinput="onKw" placeholder="搜我加的店名 / 地址 / 电话 / 商圈" confirm-type="search" />
      <text class="sclr" wx:if="{{kw}}" bindtap="clearKw">✕</text>
    </view>
    <view class="modes">
      <view class="m {{mode === 'date' ? 'on' : ''}}" bindtap="setMode" data-m="date">按日期</view>
      <view class="m {{mode === 'circle' ? 'on' : ''}}" bindtap="setMode" data-m="circle">按商圈</view>
      <!-- 与老板端一致：这颗是"动作"、朴素点（同灰底灰字），刷新中只是字色更淡 -->
      <view class="m rf {{refreshing ? 'ing' : ''}}" bindtap="onRefresh">{{refreshing ? '刷新中…' : '刷新'}}</view>
    </view>
    <view class="cnt">我加过的店 共 {{total}} 家<text wx:if="{{kw}}"> · 筛出 {{list.length}} 家</text><text wx:if="{{syncedText}}" class="st"> · 数据截至 {{syncedText}}</text></view>
  </view>

  <view wx:if="{{loading}}" class="empty">正在加载…</view>
  <view wx:elif="{{!list.length}}" class="empty">{{kw ? '换个词搜搜' : '还没加过新店 —— 点下面「＋ 加新店」现场建档'}}</view>

  <block wx:for="{{groups}}" wx:key="title" wx:for-item="g">
    <view class="gtitle" wx:if="{{g.title}}">{{g.title}}<text class="gn">{{g.items.length}} 家</text></view>
    <view class="card" wx:for="{{g.items}}" wx:key="id" wx:for-item="s" bindtap="openShop" data-id="{{s.id}}">
      <image class="pic" wx:if="{{s.photos[0]}}" src="{{s.photos[0]}}" mode="aspectFill"></image>
      <view class="cin">
        <view class="nm">{{s.name}}</view>
        <view class="sub">{{s.address || '（未填地址）'}}</view>
        <view class="tag">
          <text wx:if="{{s.area}}">{{s.area}}</text>
          <text wx:if="{{s.bizCircle}}"> · {{s.bizCircle}}</text>
          <text wx:if="{{s.by}}" class="by"> · {{s.by}} 录</text>
        </view>
      </view>
      <text class="arw">›</text>
    </view>
  </block>

  <view class="pad"></view>

  <!-- ⭐ 2026-10-15 老板要求：业务员端**底部多一个「＋ 加新店」**（老板端那份没有这个按钮） -->
  <view class="newbar"><view class="nb-btn" bindtap="goAdd">＋ 加新店</view></view>
</view>
