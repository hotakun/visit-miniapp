/* 我新加的店 —— ⭐⭐ 2026-10-15 老板定：**摆放方式与老板端「新店」页完全一致**
   （横排卡 <缩略图 + 店名/地址/区域·商圈·录入人 + 箭头> + 搜索 + 按日期/按商圈 + 数据截至），
   只是业务员端**底部多一个「＋ 加新店」**。
   ⚠️ 上面那一整块样式就是照 newshops.wxss 抄的 —— 两边要一直保持一致，
      改老板端那份时记得同步这份（老板要的就是"两边一样"）。 */
page { background: #F5F6F8; }
/* ⚠️ 底部留 100px：给固定的「＋ 加新店」让位，别挡住最后一张卡片 */
.page { padding: 10px 12px 100px; }
.bar { background: #fff; border-radius: 12px; padding: 10px 12px; margin-bottom: 10px; }
.sbox { display: flex; align-items: center; background: #F3F5F8; border-radius: 9px; padding: 7px 10px; }
.ico { font-size: 13px; margin-right: 6px; }
.sin { flex: 1; font-size: 13px; }
.sclr { color: #B7BEC7; font-size: 14px; padding: 0 4px; }
.modes { display: flex; gap: 8px; margin-top: 9px; }
.m { flex: 1; text-align: center; font-size: 12.5px; font-weight: 700; color: #68727E; background: #F3F5F8; border-radius: 8px; padding: 6px 0; }
.m.on { background: #F5531C; color: #fff; }
/* 第三颗是"动作"（刷新）——与老板端一致：朴素、同灰底灰字；刷新中只是字色更淡 */
.m.rf { background: #F3F5F8; color: #68727E; }
.m.rf.ing { background: #F3F5F8; color: #B9C1CB; }
.st { color: #B9C1CB; }
.cnt { font-size: 12px; color: #98A2AE; margin-top: 8px; }
.gtitle { font-size: 12.5px; font-weight: 800; color: #68727E; padding: 10px 2px 6px; }
.gn { color: #F5531C; font-weight: 700; margin-left: 6px; }
.card { display: flex; align-items: center; gap: 10px; background: #fff; border-radius: 12px; padding: 10px 12px; margin-bottom: 8px; }
.pic { width: 52px; height: 52px; border-radius: 9px; flex: none; background: #F0F2F6; }
.cin { flex: 1; min-width: 0; }
.nm { font-size: 14px; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.sub { font-size: 12px; color: #98A2AE; margin-top: 3px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.tag { font-size: 11.5px; color: #68727E; margin-top: 3px; }
.by { color: #98A2AE; }
.arw { color: #C3CAD4; font-size: 17px; }
.empty { text-align: center; color: #98A2AE; font-size: 13px; padding: 60px 0; }
.pad { height: 16px; }

/* ⭐ 2026-10-15 老板要求：业务员端**底部多一个「＋ 加新店」**
   —— 样式照「我的记事」的「＋ 记一笔」（fixed 吸底 + 橙色实心大按钮） */
.newbar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 20;
  padding: 10px 14px calc(10px + env(safe-area-inset-bottom)); }
.newbar .nb-btn { height: 52px; border-radius: 14px; display: flex; align-items: center; justify-content: center;
  background: var(--primary, #E8871E); color: #fff;
  font-size: 16px; font-weight: 800; letter-spacing: 1px;
  box-shadow: 0 4px 14px rgba(232, 135, 30, .30); }
