<!-- 拜访记录：结果集按客户类型动态显示 -->
<view class="page">
  <view class="vhead">
    <view class="vname">{{c.name}}</view>
    <view class="timer">⏱ {{timerText}}</view>
  </view>
  <!-- 超时预警条（2026-09-08 M1）：上限前 5 分钟出现 -->
  <view class="timeout-warn" wx:if="{{timeoutWarn}}">⏰ 拜访将在 {{timeoutLeftMin}} 分钟后自动{{result ? '提交' : '取消'}}，请尽快处理</view>

  <!-- 2026-09-11 老板定：现场拍照 / 现场录音 改为【可折叠卡片】—— 点标题栏展开收起；独立展开；默认展开 -->
  <!-- 收起时标题栏右侧显示状态摘要：已拍 N/15 张 / 未拍照；N 段 · 合计 mm:ss / 未录音 -->
  <!-- 区块顺序（2026-09-08 老板定）：现场拍照 → 现场录音 → 样品/物料 → 拜访记录 → 拜访结果 -->
  <!-- 2026-09-11：现场拍照改为【最多 15 张】—— 支持连拍（拍完自动再开相机）与相册多选；网格自动换行 -->
  <view class="sec fcard blk blk-pic">
    <view class="fc-head" bindtap="toggleFold" data-k="pic">
      <text class="fc-ic">📷</text>
      <text class="fc-t">现场拍照</text>
      <text class="fc-sum">{{pics.length ? ('已拍 ' + pics.length + '/' + maxPics + ' 张') : '未拍照'}}</text>
      <text class="fc-ar">{{foldPic ? '▸' : '▾'}}</text>
    </view>
    <view wx:if="{{!foldPic}}">
      <!-- 拍摄入口：连拍 / 相册多选（拍满后自动隐藏） -->
      <view class="picbar" wx:if="{{pics.length < maxPics}}">
        <view class="picbtn {{prepBusy ? 'busy' : ''}}" bindtap="shootPhoto">
          <text class="pb-ic">📷</text><text class="pb-tx">{{prepBusy ? '处理中…' : '拍照'}}</text>
        </view>
        <view class="picbtn ghost {{prepBusy ? 'busy' : ''}}" bindtap="pickPhoto">
          <text class="pb-ic">🖼</text><text class="pb-tx">从相册选</text>
        </view>
      </view>
      <!-- 已拍照片网格（每格固定像素、一行三格自动换行；左下角序号、右上角 ✕ 删除、点图看大图） -->
      <view class="picgrid">
        <view class="pictile" wx:for="{{pics}}" wx:key="id">
          <image class="picimg" src="{{item.thumb}}" data-src="{{item.orig}}" bindtap="previewPhoto" mode="scaleToFill"/>
          <view class="picno">{{index + 1}}</view>
          <view class="picdel" data-id="{{item.id}}" catchtap="delPhoto">✕</view>
        </view>
      </view>
      <view class="pic-tip" wx:if="{{!pics.length}}">点上面按钮拍照或从相册选（最多 {{maxPics}} 张）</view>
    </view>
  </view>

  <view class="sec fcard blk blk-rec">
    <view class="fc-head" bindtap="toggleFold" data-k="rec">
      <text class="fc-ic">🎙️</text>
      <text class="fc-t">现场录音</text>
      <text class="fc-sum">{{recs.length ? (recCountText + ' 段 · 合计 ' + recTotalText) : '未录音'}}</text>
      <text class="fc-ar">{{foldRec ? '▸' : '▾'}}</text>
    </view>
    <view wx:if="{{!foldRec}}">
      <view class="fc-sub">最多 {{maxSegs}} 段，单条最长 {{recLimitMin}} 分钟，合计 30 分钟</view>

      <!-- 录音中：计时 + 剩余倒计时（剩 30 秒红字加大闪动）+ 停止 -->
      <view class="recbox" wx:if="{{recState === 'rec'}}">
        <view class="recinfo"><text class="rcdot blink"/>录音中 {{curText}}</view>
        <view class="recleft {{recWarn ? 'warn' : ''}}">{{recLeftText}}</view>
        <view class="recstop" bindtap="onRecTap">■ 停止</view>
      </view>
      <!-- 未录音且未录满 -->
      <view class="recbox" wx:elif="{{recs.length < maxSegs}}">
        <view class="recbtn" bindtap="onRecTap"><text class="rcdot"/>开始录音</view>
        <view class="recmeta">已录 {{recCountText}} · 合计 {{recTotalText}}</view>
      </view>
      <!-- 已录满最大段数 -->
      <view class="recbox" wx:else>
        <view class="recfull">🎙️ 已录满 {{maxSegs}} 段 · 合计 {{recTotalText}}</view>
      </view>

      <!-- 已录段列表（一条条排着不覆盖：试听 / 勾选转写 / 删除） -->
      <view class="reclist" wx:if="{{recs.length}}">
        <view class="recitem" wx:for="{{recs}}" wx:key="id">
          <view class="ri-idx">{{index + 1}}</view>
          <view class="ri-play {{recPlayId === item.id ? 'on' : ''}}" bindtap="playRec" data-id="{{item.id}}">{{recPlayId === item.id ? '⏸' : '▶'}}</view>
          <view class="ri-time">{{item.text}}</view>
          <view class="ri-ck {{item.transcribe ? 'on' : ''}}" catchtap="toggleRecTr" data-i="{{index}}">✓</view>
          <view class="ri-del" catchtap="askDelRec" data-i="{{index}}">✕</view>
        </view>
      </view>

      <!-- 开始转录（老板定：按下 = 上传 + 转写勾选的段，可提前看结果） -->
      <view class="trbar" wx:if="{{recs.length}}">
        <view class="trgo {{trBusy ? 'busy' : ''}}" bindtap="startTranscribe">{{trBusy ? '提交中…' : '📝 开始转录'}}</view>
        <view class="trmsg" wx:if="{{trMsg}}">{{trMsg}}</view>
      </view>
    </view>
  </view>

  <!-- 删除单段录音：二次确认（老板定；项目铁律：页内弹层，不用 wx.showModal） -->
  <view class="c-mask" wx:if="{{delRecShow}}">
    <view class="c-box">
      <view class="ct">删除这段录音？</view>
      <view class="csub">删除后不可恢复；这一段不会再上传，也不会转写。</view>
      <view class="btn-primary" style="background:var(--danger)" bindtap="doDelRec">确认删除</view>
      <view class="again" bindtap="hideDelRec">再看看</view>
    </view>
  </view>

  <view class="sec blk blk-samp">
    <view class="fc-head" bindtap="toggleFold" data-k="samp">
      <text class="fc-ic">📦</text>
      <text class="fc-t">样品 / 物料</text>
      <text class="fc-sum">{{samples ? '已填' : '未填'}}</text>
      <text class="fc-ar">{{foldSamp ? '▸' : '▾'}}</text>
    </view>
    <view wx:if="{{!foldSamp}}">
      <input class="inp" placeholder="例：带 24 标准白 1 件样品给客户" value="{{samples}}" bindinput="onSamples"/>
    </view>
  </view>

  <view class="sec blk blk-text">
    <view class="fc-head" bindtap="toggleFold" data-k="text">
      <text class="fc-ic">✍️</text>
      <text class="fc-t">拜访记录</text>
      <text class="fc-sum {{text ? 'ok' : ''}}">{{text ? ('已填 ' + text.length + ' 字') : '未填'}}</text>
      <text class="fc-ar">{{foldText ? '▸' : '▾'}}</text>
    </view>
    <view wx:if="{{!foldText}}">
      <textarea class="inp area" placeholder="客户反馈、跟进事项、下次计划……" value="{{text}}" bindinput="onText" maxlength="-1" cursor-spacing="140" show-confirm-bar="{{false}}"></textarea>
    </view>
  </view>

  <view class="sec blk blk-res">
    <view class="fc-head" bindtap="toggleFold" data-k="res">
      <text class="fc-ic">🎯</text>
      <text class="fc-t">拜访结果</text>
      <text class="fc-sum {{result ? 'ok' : 'warn'}}">{{result ? result : '未选择'}}</text>
      <text class="fc-ar">{{foldRes ? '▸' : '▾'}}</text>
    </view>
    <view wx:if="{{!foldRes}}">
      <view class="tags">
        <view class="rtag {{result === item ? 'on' : ''}}" wx:for="{{resultList}}" wx:key="*this"
              bindtap="pickResult" data-r="{{item}}">{{item === '极有意向' ? item + ' 🔥' : item}}</view>
      </view>
    </view>
  </view>

  <view class="foot">
    <view class="btn-primary btn-blue" bindtap="submit">✓ 提交拜访</view>
  </view>

  <view class="cancel" wx:if="{{!blocked}}" bindtap="askCancel">取消拜访</view>

  <!-- 单开拦截大弹窗：任务内已有别家拜访中（停留至点击「知道了」） -->
  <view class="c-mask" wx:if="{{blocked}}">
    <view class="c-box block-box">
      <view class="block-ic">⚠️</view>
      <view class="block-msg">{{blockMsg}}</view>
      <view class="block-sub">请先完成或取消该家的拜访，再开始新的拜访</view>
      <view class="btn-primary" bindtap="goBackFromBlock">知道了</view>
    </view>
  </view>

  <!-- 取消确认弹窗：客户状态不变，任何地方可取消 -->
  <view class="c-mask" wx:if="{{cancelShow}}">
    <view class="c-box">
      <view class="ct">取消本次拜访？</view>
      <view class="csub">取消后该客户仍为「待回访」，可稍后重新开始拜访。</view>
      <view class="btn-primary" style="background:var(--danger)" bindtap="doCancel">确认取消</view>
      <view class="again" bindtap="hideCancel">再看看</view>
    </view>
  </view>

  <!-- 提交确认弹窗（2026-09-06：纯距离展示，左侧图标可点一次做收敛精确定位） -->
  <view class="c-mask" wx:if="{{confirmShow}}">
    <view class="c-box">
      <view class="ct">确认提交本次拜访？</view>
      <view class="crow" wx:if="{{distShow}}">
        <view class="cic loc {{locCooldown > 0 ? 'used' : ''}}" bindtap="onLocRefresh">
          <text wx:if="{{locRefreshing}}">{{locSpinChar}}</text>
          <text wx:elif="{{locCooldown > 0}}">{{locCooldown}}</text>
          <text wx:else>📍</text>
        </view>
        <view class="clb">{{distText}}</view>
      </view>
      <view class="crow"><view class="cic" style="background:var(--primary-tint)">⏱</view><view class="clb">{{durMins}} 分钟</view></view>
      <view class="crow" wx:if="{{evDesc}}"><view class="cic" style="background:#FFF3E0">📎</view><view class="clb">{{evDesc}}</view></view>
      <view class="btn-primary" bindtap="confirmSubmit">确认提交</view>
      <view class="again" bindtap="hideConfirm">再看看</view>
    </view>
  </view>
</view>
