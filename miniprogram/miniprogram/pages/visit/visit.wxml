<!-- 拜访记录：结果集按客户类型动态显示 -->
<!-- ⭐ 2026-10-07 老板定：本页导航栏**整条不显示**（visit.json → "navigationStyle":"custom"）→
     自己按状态栏高度留白（st 由 js 动态取，20~54px 因机型而异）；顶上没有任何题头。
     ⭐ 留白改由作战条承担（见下面 .hud 的内联 padding-top），深蓝条一直顶到状态栏；
        同时整页左右**贯穿到屏幕两边**（.page 不设左右内边距） -->
<view class="page">
  <!-- ⭐ 2026-10-07 老板定：顶部「拜访中」作战条（深蓝整条）——
       ① 和客户详情页的纯白卡一眼分得开（治"点进来不知道换页了"）
       ② 店名 + 大号计时 + 现场距离，一行看全
       ③ ⭐ 本页导航栏整条不显示（navigationStyle:custom）→ **页面上不留返回键**；
          必须「提交拜访」或「取消拜访」才能离开（系统返回也拦，见 js 的 _lockLeave） -->
  <!-- ⭐ 2026-10-08 老板定：「切换回上家」跳过来后的提示，**两行**（已切回「XXX」/ 请正规结束拜访）。
       ⚠️ 不能用 wx.showToast —— 它**不支持换行**（会被压成一行空格）。 -->
  <view class="swtip" wx:if="{{switchTip}}">
    <view class="swtip-1">已切回「{{switchTip}}」</view>
    <view class="swtip-2">请正规结束拜访</view>
  </view>

  <view class="hud" style="padding-top:{{st + 12}}px">
    <view class="hud-t">
      <!-- ⭐ 2026-10-08 老板定：**去掉返回键**（原来这里有个「‹」= 留了个后门）——
           本页必须「提交拜访」或「取消拜访」才能离开；系统返回/iOS 右滑由
           wx.enableAlertBeforeUnload 拦一道（见 js 的 _lockLeave）。 -->
      <view class="hud-dot" wx:if="{{!isEdit}}"></view>
      <text class="hud-k">{{isEdit ? '编辑拜访记录' : '拜访中'}}</text>
      <text class="hud-time" wx:if="{{!isEdit}}">{{timerText}}</text>
    </view>
    <view class="hud-n">{{c.name}}</view>
    <view class="hud-m" wx:if="{{distLive}}">📍 {{distLive}}</view>
  </view>
  <!-- 超时预警条（2026-09-08 M1）：上限前 5 分钟出现 -->
  <view class="timeout-warn" wx:if="{{timeoutWarn && !isEdit}}">⏰ 拜访将在 {{timeoutLeftMin}} 分钟后自动{{result ? '提交' : '取消'}}，请尽快处理</view>

  <!-- 2026-09-11 老板定：现场拍照 / 现场录音 改为【可折叠卡片】—— 点标题栏展开收起；独立展开；默认展开 -->
  <!-- 收起时标题栏右侧显示状态摘要：已拍 N/15 张 / 未拍照；N 段 · 合计 mm:ss / 未录音 -->
  <!-- 区块顺序（2026-09-08 老板定）：现场拍照 → 现场录音 → 样品/物料 → 拜访记录 → 拜访结果 -->
  <!-- 2026-09-11：现场拍照改为【最多 15 张】—— 支持连拍（拍完自动再开相机）与相册多选；网格自动换行 -->
  <!-- ⭐⭐ 2026-10-07 老板定：**不要卡片，直接平铺** —— 整页内容是一块通铺白板（.plate），
       块与块之间只用一条分割线（屏幕利用率更高，看着也更像"一条作业流程"）。
       ⚠️ 原来的 .sec / .fcard / .blk / blk-XXX（淡色卡片 + 圆角 + 投影）全部去掉；
          标题栏改成「编号 + 深蓝竖条 + 深蓝字」。 -->
  <view class="plate">
  <view class="step">
    <view class="fc-head" bindtap="toggleFold" data-k="pic">
      <text class="st-no">1</text>
      <text class="fc-t">现场拍照</text>
      <text class="fc-sum">{{pics.length ? ('已拍 ' + pics.length + '/' + maxPics + ' 张') : '未拍照'}}</text>
      <text class="fc-ar">{{foldPic ? '▸' : '▾'}}</text>
    </view>
    <view class="fc-body" wx:if="{{!foldPic}}">
      <!-- ⭐⭐ 2026-10-07 老板定：**拍照改成「框式」**，与「门头照 / 加新店」是同一套操作 ——
           永远摆着 3 个虚线框（空框本身就是"点这儿拍"的提示），拍满一排**自动补出下一排**。
           点空框 → 系统弹「拍照 / 从相册选」；有图那格：左下角序号、右上角 ✕ 删除、点图看大图。 -->
      <view class="framegrid">
        <view class="frame {{item.pic ? 'full' : ''}}" wx:for="{{slots}}" wx:key="k" bindtap="tapSlot">
          <block wx:if="{{item.pic}}">
            <image class="picimg" src="{{item.pic.thumb}}" data-src="{{item.pic.orig}}" catchtap="previewPhoto" mode="scaleToFill"/>
            <view class="picno">{{item.no}}</view>
            <view class="picdel" data-id="{{item.pic.id}}" catchtap="delPhoto">✕</view>
          </block>
          <block wx:else>
            <text class="f-ic">📷</text>
            <text class="f-tx">{{prepBusy ? '处理中…' : '拍照'}}</text>
          </block>
        </view>
      </view>
      <view class="pic-tip">最多 {{maxPics}} 张 · 点虚线框拍一张，拍满一排会自动出现下一排</view>
    </view>
  </view>

  <!-- 2026-09-11：录音开关——后台设置页可关闭（关闭后整块录音区不显示；云端也会拒收录音） -->
  <view class="step" wx:if="{{recEnabled}}">
    <view class="fc-head" bindtap="toggleFold" data-k="rec">
      <text class="st-no">2</text>
      <text class="fc-t">现场录音</text>
      <text class="fc-sum">{{recs.length ? (recCountText + ' 段 · 合计 ' + recTotalText) : '未录音'}}</text>
      <text class="fc-ar">{{foldRec ? '▸' : '▾'}}</text>
    </view>
    <view class="fc-body" wx:if="{{!foldRec}}">
      <view class="fc-sub">最多 {{maxSegs}} 段，单条最长 {{recLimitMin}} 分钟，合计 30 分钟</view>

      <!-- 录音中：计时 + 剩余倒计时（剩 30 秒红字加大闪动）+ 停止 -->
      <view class="recbox" wx:if="{{recState === 'rec'}}">
        <view class="recinfo"><text class="rcdot blink"/>录音中 {{curText}}</view>
        <view class="recleft {{recWarn ? 'warn' : ''}}">{{recLeftText}}</view>
        <view class="recstop" bindtap="onRecTap">■ 停止</view>
      </view>
      <!-- 未录音且未录满 -->
      <view class="recbox" wx:elif="{{recs.length < maxSegs}}">
        <view class="recbtn" bindtap="onRecTap"><text class="rcdot"/>开始录音</view>
        <view class="recmeta">已录 {{recCountText}} · 合计 {{recTotalText}}</view>
      </view>
      <!-- 已录满最大段数 -->
      <view class="recbox" wx:else>
        <view class="recfull">🎙️ 已录满 {{maxSegs}} 段 · 合计 {{recTotalText}}</view>
      </view>

      <!-- 已录段列表（一条条排着不覆盖：试听 / 勾选转写 / 删除） -->
      <view class="reclist" wx:if="{{recs.length}}">
        <view class="recitem" wx:for="{{recs}}" wx:key="id">
          <view class="ri-idx">{{index + 1}}.</view>
          <view class="ri-play {{recPlayId === item.id ? 'on' : ''}}" bindtap="playRec" data-id="{{item.id}}">{{recPlayId === item.id ? '⏸' : '▶'}}</view>
          <view class="ri-time">{{item.text}}</view>
          <view class="ri-ck {{item.transcribe ? 'on' : ''}}" catchtap="toggleRecTr" data-i="{{index}}">✓</view>
          <view class="ri-del" catchtap="askDelRec" data-i="{{index}}">✕</view>
        </view>
      </view>

      <!-- 开始转录（老板定：按下 = 上传 + 转写勾选的段，可提前看结果） -->
      <view class="trbar" wx:if="{{recs.length}}">
        <view class="trgo {{trBusy ? 'busy' : ''}}" bindtap="startTranscribe">{{trBusy ? '提交中…' : '📝 开始转录'}}</view>
        <view class="trmsg" wx:if="{{trMsg}}">{{trMsg}}</view>
      </view>
    </view>
  </view>

  <!-- 删除单段录音：二次确认（老板定；项目铁律：页内弹层，不用 wx.showModal） -->
  <view class="c-mask" wx:if="{{delRecShow}}">
    <view class="c-box">
      <view class="ct">删除这段录音？</view>
      <view class="csub">删除后不可恢复；这一段不会再上传，也不会转写。</view>
      <view class="btn-primary" style="background:#FDEDED;color:#E5484D;font-weight:800;box-shadow:none;border:1px solid #F7D9D9" bindtap="doDelRec">确认删除</view>
      <view class="again" bindtap="hideDelRec">再看看</view>
    </view>
  </view>

  <view class="step">
    <view class="fc-head" bindtap="toggleFold" data-k="samp">
      <text class="st-no">3</text>
      <text class="fc-t">样品 / 物料</text>
      <text class="fc-sum">{{samples ? '已填' : '未填'}}</text>
      <text class="fc-ar">{{foldSamp ? '▸' : '▾'}}</text>
    </view>
    <view class="fc-body" wx:if="{{!foldSamp}}">
      <textarea class="inp area-sm" placeholder="例：带 24 标准白 1 件样品给客户（可多行填写）" value="{{samples}}" bindinput="onSamples" maxlength="-1" cursor-spacing="140" show-confirm-bar="{{false}}"></textarea>
    </view>
  </view>

  <view class="step">
    <view class="fc-head" bindtap="toggleFold" data-k="text">
      <text class="st-no">4</text>
      <text class="fc-t">拜访记录</text>
      <text class="fc-sum {{text ? 'ok' : ''}}">{{text ? ('已填 ' + text.length + ' 字') : '未填'}}</text>
      <text class="fc-ar">{{foldText ? '▸' : '▾'}}</text>
    </view>
    <view class="fc-body" wx:if="{{!foldText}}">
      <textarea class="inp area" placeholder="客户反馈、跟进事项、下次计划……" value="{{text}}" bindinput="onText" maxlength="-1" cursor-spacing="140" show-confirm-bar="{{false}}"></textarea>
    </view>
  </view>

  <view class="step">
    <view class="fc-head" bindtap="toggleFold" data-k="res">
      <text class="st-no">5</text>
      <text class="fc-t">拜访结果</text>
      <text class="fc-sum {{result ? 'ok' : 'warn'}}">{{result ? result : '未选择'}}</text>
      <text class="fc-ar">{{foldRes ? '▸' : '▾'}}</text>
    </view>
    <view class="fc-body" wx:if="{{!foldRes}}">
      <view class="tags">
        <!-- ⭐ 2026-10-11 老板定：结果**可多选，最多 2 个**（item 是 {n,on}；wxml 不能写 indexOf，选中态在 js 的 _markResults 里算好） -->
        <view class="rtag {{item.on ? 'on' : ''}}" wx:for="{{resultList}}" wx:key="n"
              bindtap="pickResult" data-r="{{item.n}}">{{item.n}}</view>
      </view>
    </view>
  </view>
  </view><!-- /plate：通铺白板到此为止 -->

  <!-- ⭐⭐ 2026-10-07 老板定：底部改成**固定贴底的一条白栏**（原来是一个悬浮胶囊 + 页内"取消拜访"），
       两个按钮**左右并排**：「✓ 提交拜访」占 2/3（主操作 · 蓝底）、「取消本次拜访」占 1/3（次要 · 白底描边）。
       ⚠️ 单开拦截（blocked）时取消按钮置灰，点不动。 -->
  <view class="foot">
    <!-- ⭐ 2026-10-10：编辑模式只留「✓ 保存修改」（占满整条）；正常拜访仍是「提交 + 取消」两个 -->
    <view class="fbtn-main" style="{{isEdit ? 'flex:1' : ''}}" bindtap="submit">{{isEdit ? '✓ 保存修改' : '✓ 提交拜访'}}</view>
    <view class="fbtn-cancel" wx:if="{{!blocked && !isEdit}}" bindtap="askCancel">取消本次拜访</view>
    <view class="fbtn-cancel off" wx:elif="{{!isEdit}}">取消本次拜访</view>
  </view>

  <!-- 单开拦截大弹窗：任务内已有别家拜访中（停留至点击「知道了」） -->
  <view class="c-mask" wx:if="{{blocked}}">
    <view class="c-box block-box">
      <view class="block-ic">⚠️</view>
      <!-- 三段式（2026-09-12 老板定）：① 店名单独一行 ②「还在拜访中…」另起一行（带省略号）③ 提示居中、逗号后换行 -->
      <view class="block-msg">{{blockMsg}}</view>
      <view class="block-msg2">还在拜访中…</view>
      <view class="block-sub">请先完成或取消该家的拜访，</view>
      <view class="block-sub" style="margin-top:0">再开始新的拜访</view>
      <view class="btn-primary" bindtap="goBackFromBlock">知道了</view>
      <!-- ⭐ 2026-10-08 老板定：除「知道了」，再加两个按钮 ——
           「切换回上家」= 直接进正在拜访的那一家的拜访页；「取消上家拜访」= 取消掉那家的拜访中（取消完自动继续本家）
           ⚠️ 按钮文案**不带店名**：店名太长会撑爆按钮（上方 blockMsg 已经显示了完整店名，够认）。 -->
      <view class="blockbtn-row">
        <view class="blockbtn" bindtap="switchToOngoing">切换回上家...</view>
        <view class="blockbtn warn" bindtap="cancelOngoing">取消上家拜访</view>
      </view>
    </view>
  </view>

  <!-- 取消确认弹窗：客户状态不变，任何地方可取消 -->
  <view class="c-mask" wx:if="{{cancelShow}}">
    <view class="c-box">
      <view class="ct">取消本次拜访？</view>
      <view class="csub">取消后该客户仍为「待回访」，可稍后重新开始拜访。</view>
      <view class="btn-primary" style="background:#FDEDED;color:#E5484D;font-weight:800;box-shadow:none;border:1px solid #F7D9D9" bindtap="doCancel">确认取消</view>
      <view class="again" bindtap="hideCancel">再看看</view>
    </view>
  </view>

  <!-- 提交确认弹窗（2026-09-06：纯距离展示，左侧图标可点一次做收敛精确定位） -->
  <view class="c-mask" wx:if="{{confirmShow}}">
    <view class="c-box">
      <view class="ct">确认提交本次拜访？</view>
      <view class="crow" wx:if="{{distShow}}">
        <view class="cic loc {{locCooldown > 0 ? 'used' : ''}}" bindtap="onLocRefresh">
          <text wx:if="{{locRefreshing}}">{{locSpinChar}}</text>
          <text wx:elif="{{locCooldown > 0}}">{{locCooldown}}</text>
          <text wx:else>📍</text>
        </view>
        <view class="clb">{{distText}}</view>
      </view>
      <view class="crow"><view class="cic" style="background:var(--primary-tint)">⏱</view><view class="clb">{{durMins}} 分钟</view></view>
      <view class="crow" wx:if="{{evDesc}}"><view class="cic" style="background:#FFF3E0">📎</view><view class="clb">{{evDesc}}</view></view>
      <view class="btn-primary" bindtap="confirmSubmit">确认提交</view>
      <view class="again" bindtap="hideConfirm">再看看</view>
    </view>
  </view>
</view>
