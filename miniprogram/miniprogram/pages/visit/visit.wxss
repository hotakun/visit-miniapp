/* 2026-09-11 老板定：拜访页页面底色再加深一档（#DDE2EA → #D0D6E0），只覆盖本页 */
page { background: #D0D6E0; }
.page { padding: 16px 18px 150px; }
.vhead { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
.vname { font-size: 19px; font-weight: 800; flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.timer { display: inline-flex; flex-shrink: 0; background: #1D4ED8; color: #FFFFFF; font-size: 14px; font-weight: 800; padding: 7px 13px; border-radius: 999px; font-variant-numeric: tabular-nums; letter-spacing: 1px; }
/* 超时预警条（2026-09-08 M1） */
.timeout-warn { margin-top: 12px; background: #FDF1F1; border: 1px solid #F5C2C2; color: #C0392B; border-radius: 12px; padding: 9px 12px; font-size: 13px; font-weight: 700; line-height: 1.5; }
.sec { margin-top: 16px; }
/* ===== 区块配色（2026-09-11 老板定：只有【标题栏】带淡色，展开的内容区保持白色；颜色再淡一档）===== */
/* 思路：卡片整体白底 → 只有标题栏一条极淡雾面色，内容区纯白（左侧色条已去掉，2026-09-11 老板定）*/
.blk { position: relative; border-radius: 16px; padding: 13px 15px; box-shadow: 0 2px 10px rgba(31,36,48,.05); background: #fff; overflow: hidden; }
/* 标题栏：通栏淡色底 + 顶部圆角（负 margin 撑满卡片上沿，实现「只有标题带色」）*/
.blk .fc-head { margin: -13px -15px 12px; padding: 12px 15px; border-radius: 16px 16px 0 0; border-bottom: 1px solid #F0F2F5; }
.blk-pic  .fc-head { background: #F7FAFD; } /* 现场拍照 · 雾蓝 */
.blk-rec  .fc-head { background: #F8F7FD; } /* 现场录音 · 雾紫 */
.blk-samp .fc-head { background: #FDFAF6; } /* 样品物料 · 雾杏 */
.blk-text .fc-head { background: #F7FBF8; } /* 拜访记录 · 雾绿 */
.blk-res  .fc-head { background: #FDF8F9; } /* 拜访结果 · 雾玫 */
/* ===== 折叠卡片（2026-09-11 老板定：五个区块都可点标题栏展开收起）===== */
.fcard { border-radius: 16px; padding: 13px 15px; box-shadow: 0 2px 10px rgba(31,36,48,.05); }
/* 摘要状态色（2026-09-11）：已填 / 已选 = 绿；未选择 = 红（提醒提交前必选） */
.fc-sum.ok { color: var(--green); }
.fc-sum.warn { color: var(--danger); }
.fc-head { display: flex; align-items: center; gap: 9px; padding-bottom: 11px; border-bottom: 1px solid var(--line); margin-bottom: 12px; }
.fc-ic { font-size: 16px; flex-shrink: 0; }
.fc-t { font-size: 14px; font-weight: 800; flex-shrink: 0; }
/* 收起时靠这行摘要一眼看到状态（已拍 4/15 张 / 2 段 · 合计 01:23 / 未拍照 / 未录音） */
.fc-sum { flex: 1; min-width: 0; font-size: 12px; font-weight: 700; color: var(--sub); text-align: right; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.fc-ar { width: 20px; text-align: center; font-size: 12px; color: #B7BEC7; flex-shrink: 0; }
.fc-sub { margin: 0 0 9px; font-size: 12px; color: var(--sub); font-weight: 600; }
.st { font-size: 13.5px; font-weight: 800; margin-bottom: 9px; }
.tags { display: grid; grid-template-columns: repeat(2, 1fr); gap: 9px; }
.rtag { padding: 9px 10px; border-radius: 13px; background: #fff; border: 1.5px solid var(--line); text-align: center; font-size: 14px; font-weight: 700; color: #4A5360; }
.rtag.on { background: var(--primary); border-color: var(--primary); color: #fff; box-shadow: 0 6px 14px rgba(245,83,28,.3); }
.inp { width: 100%; border: none; background: #fff; border-radius: 13px; height: 48px; line-height: 48px; padding: 0 14px; font-size: 14px; box-shadow: 0 2px 10px rgba(31,36,48,.06); box-sizing: border-box; }
/* 多行文字框（2026-09-11 老板定：样品 / 物料 与 拜访记录 都放大）*/
.area { height: 200px; min-height: 200px; padding: 13px 14px; line-height: 1.7; }
.area-sm { height: 96px; min-height: 96px; padding: 12px 14px; line-height: 1.7; }
.foot { position: fixed; left: 0; right: 0; bottom: 0; padding: 12px 18px 24px; background: linear-gradient(180deg, rgba(208,214,224,0), #D0D6E0 30%); }
.btn-blue { background: var(--blue); }
/* 取消拜访：窄按钮（灰字细边框），离文字框远防误触（老板 2026-09-04 定） */
.cancel { width: 130px; margin: 48px auto 0; text-align: center; font-size: 12.5px; font-weight: 600; color: var(--sub); background: #F7F8FA; border: 1px solid #E4E7EC; border-radius: 999px; padding: 8px 0; }
.csub { font-size: 13px; color: var(--sub); font-weight: 600; text-align: center; margin-bottom: 8px; }
/* 单开拦截大弹窗（大字大卡片，不自动消失） */
.block-box { max-width: 360px; padding: 26px 22px 20px; text-align: center; }
.block-ic { font-size: 46px; line-height: 1; margin-bottom: 14px; }
.block-msg { font-size: 18px; font-weight: 800; line-height: 1.5; }
.block-sub { margin-top: 8px; font-size: 13px; color: var(--sub); font-weight: 600; }
.block-box .btn-primary { margin-top: 18px; }
/* 提交确认弹窗 */
.c-mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; background: rgba(31,36,48,.5); display: flex; align-items: center; justify-content: center; z-index: 99; padding: 0 34px; }
.c-box { width: 100%; max-width: 320px; background: #fff; border-radius: 18px; padding: 20px 18px 16px; box-shadow: 0 20px 60px rgba(0,0,0,.25); }
.c-box .ct { font-size: 16px; font-weight: 800; text-align: center; margin-bottom: 14px; }
.crow { display: flex; align-items: center; gap: 10px; padding: 9px 0; }
.cic { width: 38px; height: 38px; border-radius: 11px; display: flex; align-items: center; justify-content: center; font-size: 16px; flex-shrink: 0; }
.cic.loc { background: var(--green-tint); }
.cic.loc.used { background: #E5E8EC; color: #9AA1AB; }
.clb { flex: 1; font-size: 14px; font-weight: 700; }
.csl { font-size: 12px; color: var(--sub); font-weight: 600; }
.c-box .btn-primary { height: 46px; margin-top: 10px; }
.again { text-align: center; font-size: 13px; color: var(--sub); font-weight: 600; padding: 10px 0 0; }
/* ===== 现场证据（2026-09-07）：照片网格 + 录音状态盒 ===== */
/* 2026-09-11 老板定：三格一行 —— 卡内可用宽约 618rpx，3×192rpx + 2×16rpx = 608rpx 正好放下 */
.picgrid { display: flex; flex-wrap: wrap; gap: 16rpx; }
/* ===== 拍照入口（2026-09-11 老板定：更精致 —— 主按钮实色渐变 + 柔和阴影；次按钮白底细描边）===== */
.picbar { display: flex; gap: 10px; margin-bottom: 10px; }
.picbtn { flex: 1; height: 46px; border-radius: 13px; display: flex; align-items: center; justify-content: center; gap: 6px;
          background: linear-gradient(135deg, #FF8A4C, #F5531C); color: #fff; font-size: 14px; font-weight: 800;
          letter-spacing: .5px; box-shadow: 0 4px 12px rgba(245,83,28,.26); }
.picbtn.ghost { background: #fff; color: #4A5360; border: 1px solid #E2E6EB; box-shadow: 0 1px 4px rgba(31,36,48,.05); }
.pb-ic { font-size: 15px; line-height: 1; }
.pb-tx { font-size: 14px; }
.picbtn.busy { opacity: .6; }
.pic-tip { margin-top: 8px; font-size: 12px; color: var(--sub); font-weight: 600; }
/* 照片格：192rpx × 144rpx（4:3）固定像素，一行三格 */
.pictile { position: relative; width: 192rpx; height: 144rpx; flex: none; border-radius: 12px; overflow: hidden; background: #F0F2F5; }
.picimg { position: absolute; left: 0; top: 0; width: 100%; height: 100%; display: block; }
/* 删除圆标（2026-09-11 老板定：更靠右上角、更小）*/
.picdel { position: absolute; top: 4px; right: 4px; width: 20px; height: 20px; line-height: 19px; text-align: center; background: rgba(0,0,0,.5); color: #fff; border-radius: 50%; font-size: 10px; font-weight: 700; z-index: 2; }
/* 左下角照片序号（2026-09-11 老板定：纯描边数字、无底色、更靠左下角）*/
.picno { position: absolute; left: 4px; bottom: 1px; padding: 0 2px; color: #fff; font-size: 15px; font-weight: 800; line-height: 1.1;
         font-variant-numeric: tabular-nums; z-index: 2;
         text-shadow: 0 0 3px rgba(0,0,0,.9), 0 0 6px rgba(0,0,0,.6), 0 1px 2px rgba(0,0,0,.85); }
.pictile.add.busy { opacity: .6; }
.picempty { position: absolute; left: 0; top: 0; width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; background: #fff; border: 1.5px dashed #D8DCE3; border-radius: 13px; box-sizing: border-box; color: #B7BEC7; }
.picempty.busy { opacity: .6; }
.addic { font-size: 26px; line-height: 1; }
.addt { margin-top: 5px; font-size: 11px; color: var(--sub); font-weight: 600; }
.recbox { display: flex; align-items: center; justify-content: space-between; gap: 10px; background: #fff; border-radius: 13px; padding: 12px 14px; box-shadow: 0 2px 10px rgba(31,36,48,.06); }
/* 开始录音按钮（2026-09-11 老板定：更精致 —— 白底胶囊 + 红点带晕，「圆点」即录音语义）*/
.recbtn { display: inline-flex; align-items: center; gap: 8px; background: #fff; color: #1F2430; font-size: 14.5px; font-weight: 800;
          padding: 11px 20px 11px 17px; border-radius: 999px; border: 1px solid #E4E7EC; box-shadow: 0 2px 8px rgba(31,36,48,.06); }
.rcdot { width: 14px; height: 14px; border-radius: 50%; background: #E5484D; flex-shrink: 0;
         box-shadow: 0 0 0 3px rgba(229,72,77,.14); }
.rcdot.blink { animation: recblink 1s ease-in-out infinite; }
@keyframes recblink { 50% { opacity: .15; } }
.recinfo { display: inline-flex; align-items: center; gap: 7px; font-size: 15px; font-weight: 800; color: var(--danger); font-variant-numeric: tabular-nums; }
.recinfo.done { color: #1D1D1F; }
.recstop { background: #1D1D1F; color: #fff; font-size: 13px; font-weight: 800; padding: 10px 18px; border-radius: 999px; }
.recops { display: flex; gap: 8px; }
.recop { padding: 8px 14px; border-radius: 999px; border: 1.5px solid #E4E7EC; font-size: 13px; font-weight: 700; color: #4A5360; background: #fff; }
.recop.on { background: var(--primary-tint); border-color: var(--primary); color: var(--primary); }
/* ===== 多段录音（2026-09-11 M2b）===== */
.recmeta { font-size: 12px; color: var(--sub); font-weight: 600; }
.recfull { font-size: 13.5px; font-weight: 700; color: var(--sub); }
.recleft { font-size: 13px; font-weight: 800; color: #4A5360; font-variant-numeric: tabular-nums; }
/* 剩 ≤30 秒：红字 + 加大 + 闪动（老板定） */
.recleft.warn { color: var(--danger); font-size: 16.5px; animation: recwarn .9s ease-in-out infinite; }
@keyframes recwarn { 50% { opacity: .22; } }
.reclist { margin-top: 9px; }
/* 录音段卡片（2026-09-11 老板定：去掉声音波纹，卡片本身改为【从下往上 深绿 → 中绿】渐变）*/
.recitem { position: relative; display: flex; align-items: center; gap: 9px; border-radius: 14px;
           padding: 10px 12px; margin-top: 8px; border: 1px solid #2C8A50; overflow: hidden;
           background: linear-gradient(0deg, #1E7A45 0%, #46B173 100%); }
.ri-idx { font-size: 11px; font-weight: 800; color: rgba(255,255,255,.75); flex-shrink: 0; }
.ri-play { width: 30px; height: 30px; border-radius: 50%; background: #fff; color: #1E7A45; display: flex; align-items: center; justify-content: center; font-size: 12px; flex-shrink: 0; }
.ri-play.on { background: #0E4F2C; color: #fff; }
.ri-time { flex: 1; font-size: 14px; font-weight: 800; font-variant-numeric: tabular-nums; color: #fff; padding-right: 4px; }
/* 转文字勾选框（2026-09-11：白底方框，在绿卡上看得清；往中间挪，拉开与删除键距离防误触）*/
.ri-ck { width: 20px; height: 20px; border-radius: 6px; border: 1.5px solid rgba(255,255,255,.85); background: rgba(255,255,255,.92); flex-shrink: 0; margin-right: 14px;
         display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 900; color: transparent; }
.ri-ck.on { background: #fff; border-color: #fff; color: #1E7A45; }
/* 删除键（2026-09-11 老板定：再小一些，降低误触）*/
.ri-del { width: 24px; height: 24px; border-radius: 50%; background: rgba(255,255,255,.22); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 11px; flex-shrink: 0; }
.trbar { display: flex; align-items: center; gap: 8px; margin-top: 10px; }
/* 2026-09-11 老板定：「开始转录」朴素化、小一些、靠右（原橙色渐变太抢眼）*/
.trgo { margin-left: auto; padding: 6px 12px; border-radius: 999px; border: 1px solid #E4E7EC;
        background: #fff; color: #4A5360; font-size: 12px; font-weight: 700; flex-shrink: 0; }
.trgo.busy { opacity: .6; }
.trmsg { flex: 1; min-width: 0; font-size: 11.5px; color: var(--sub); font-weight: 600; text-align: left; }
