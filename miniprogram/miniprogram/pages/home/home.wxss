.page { padding: 20px 18px 110px; }
.head { display: flex; align-items: center; gap: 12px; padding: 6px 2px 18px; }
.head-logo { width: 56px; height: 56px; border-radius: 50%; flex-shrink: 0; box-shadow: 0 4px 12px rgba(245,83,28,.25); }
.head-txt { min-width: 0; }
.hi { font-size: 22px; font-weight: 800; line-height: 1.3; }
.pep { margin-top: 4px; font-size: 13px; font-weight: 400; }
.pep-t { color: var(--sub); }
/* emoji 不设文字色：保持系统彩色渲染，不被灰色染色 */
.pep-e { margin-left: 2px; }
.subBtn { margin: 0 0 12px; padding: 11px 14px; border-radius: 13px; background: #FFF3EC; border: 1.5px solid #FFCBB2; font-size: 12.5px; font-weight: 700; color: #B93A08; }
.sub-banner { margin: 0 0 12px; padding: 11px 14px; border-radius: 13px; background: #FFF3EC; border: 1.5px solid #FFCBB2; font-size: 12.5px; font-weight: 700; color: #B93A08; display: flex; align-items: center; }
.sub-banner .x { margin-left: auto; font-weight: 800; padding: 0 6px; }
/* 底部 Tab 栏（任务/地图/我的） */
.tabbar { position: fixed; left: 0; right: 0; bottom: 0; height: 66px; background: rgba(255,255,255,.97); display: flex; box-shadow: 0 -2px 12px rgba(31,36,48,.06); z-index: 50; }
.tabbar .tb { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px; font-size: 11px; color: var(--sub); font-weight: 700; }
.tabbar .tb .tic { font-size: 20px; line-height: 1; }
.tabbar .tb.on { color: var(--primary-deep); }
/* 我的任务标题栏（下移远离大卡辉光，层级置顶不被投影盖住） */
.sec-t { display: flex; align-items: center; margin: 26px 2px 16px; position: relative; z-index: 1; }
.sec-t .st-t { font-size: 17px; font-weight: 800; }
.sec-t .st-more { margin-left: auto; font-size: 13px; color: var(--sub); font-weight: 600; }
/* 今日计划橙色大卡（对齐演示设计） */
.hero { margin: 0 0 14px; padding: 24px 20px 22px; border-radius: 22px; color: #fff; position: relative; overflow: hidden; background: linear-gradient(125deg, #FF8A50 0%, #F5531C 55%, #D93E0E 100%); box-shadow: 0 12px 30px rgba(245, 83, 28, .35); }
/* 右上角半透明圆弧装饰 */
.hero::after { content: ""; position: absolute; right: -46px; top: -46px; width: 160px; height: 160px; border-radius: 50%; background: rgba(255, 255, 255, .14); }
.hero .h1 { font-size: 14px; opacity: .92; font-weight: 600; transform: translateY(-10px); }
.hbody { margin-top: 12px; }
.hero .big { font-size: 36px; font-weight: 800; line-height: 1; margin: 8px 0 6px; letter-spacing: 1px; }
.hero .big .u { font-size: 15px; font-weight: 600; margin-left: 4px; opacity: .92; }
.hero .emoji-big { font-size: 40px; line-height: 1.2; margin: 4px 0 2px; }
.hero .sub { font-size: 12.5px; opacity: .85; margin-bottom: 18px; transform: translateY(10px); }
/* 环形进度：绝对定位右上（demo 同位置） */
.hring { position: absolute; right: 20px; top: 34px; width: 72px; height: 72px; }
.ring-canvas { width: 72px; height: 72px; }
.hring .pct { position: absolute; left: 0; right: 0; top: 0; bottom: 0; display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: 800; }
/* 开始按钮：左下胶囊，宽度自适应，不越过中线 */
.hero .go { margin-top: 8px; display: inline-flex; align-items: center; gap: 6px; background: rgba(255, 255, 255, .2); padding: 10px 18px; border-radius: 999px; font-size: 13px; font-weight: 700; }
.task-card { background: #fff; border-radius: 16px; padding: 20px 18px; margin-bottom: 14px; box-shadow: 0 2px 10px rgba(31,36,48,.06); }
.task-card.ongoing { border: 1.5px solid var(--blue); } /* 任务内有拜访中客户：蓝色边框（老板 2026-09-06 定） */
/* 已完成任务：比页面背景稍深的灰底 + 整体色彩减淡，与新任务区分 */
.task-card.done { background: #E9EBEF; border: 1px solid #E0E3E7; opacity: .85; }
.task-card.done .pfill { filter: grayscale(.5); }
.row1 { display: flex; align-items: center; gap: 8px; }
.tname { flex: 1; font-size: 16.5px; font-weight: 700; }
.state { font-size: 12px; font-weight: 700; padding: 5px 10px; border-radius: 999px; }
.state.going { background: var(--primary-tint); color: var(--primary-deep); }
.state.review { background: var(--warn-tint); color: #B97A0B; }
.state.expired { background: #FCEBEC; color: var(--danger); }
.state.done { background: var(--green-tint); color: var(--green); }
.row2 { display: flex; justify-content: space-between; margin: 14px 0 10px; font-size: 13px; color: var(--sub); font-weight: 600; }
.pbar { height: 8px; background: #F0F2F5; border-radius: 99px; overflow: hidden; }
.pfill { height: 100%; border-radius: 99px; background: linear-gradient(90deg,#FF8A50,#F5531C); }
.empty { text-align: center; color: var(--sub); font-size: 14px; margin-top: 60px; }
.loading { text-align: center; color: var(--sub); font-size: 13px; margin-top: 40px; }

/* 老板模式（2026-09-09 §7.13）：数字胶囊带 + 任务卡业务员名 */
.boss-stats{display:flex;gap:10rpx;margin:18rpx 0 6rpx}
.bs{flex:1;background:#FFFFFF;border-radius:18rpx;padding:20rpx 0;text-align:center;box-shadow:0 2rpx 10rpx rgba(31,36,48,.05)}
.bs-n{font-size:40rpx;font-weight:800;color:#1F2430;line-height:1.1}
.bs-l{font-size:22rpx;color:#66707A;margin-top:6rpx}
.c-blue{color:#2F80ED}
.c-orange{color:#F5531C}
.c-red{color:#E5484D}
.towner{font-size:24rpx;color:#66707A;font-weight:400}
