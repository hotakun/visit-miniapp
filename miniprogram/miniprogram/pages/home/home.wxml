<!-- 首页：任务列表 -->
<view class="page">
  <!-- 2026-09-12 老板定：**页面右上角**极小的分享按钮（图标＝2 号「方框 + 上箭头」）
       ⚠️ 必须用 button open-type="share"：小程序无法用代码直接拉起好友列表，只有这种 button 能唤起微信原生分享面板
       ⚠️ 图标改用**原装文件**（2026-09-12 老板问「为什么不用原装的 icon」后改回）：
          images/share-icon.png —— 由 2 号图标**矢量精确渲染**的 90×90 透明底 PNG（比例标准，不是手画的）。
          中途因图片方案出过一次问题，我一度退回"纯 CSS 手画"，结果线条不如原装 → 现在改回文件方案。
          那次消失的真正原因是「容器与 button 互相用 100% 导致尺寸算成 0」，**不是图片本身**；
          只要尺寸写死 px（见下），文件方案既精确又稳定。
       ⚠️ 尺寸/定位规矩（都踩过坑，别再犯）：
          ① 定位绝不能写在 <button> 上（微信 button 内置样式 position:relative / margin:auto 会顶掉它）；
          ② 容器与 button 不能互相用 100%（尺寸循环依赖 → 算成 0 → 图标消失）；
          ③ 单位一律用 px，不用 rpx（rpx 在内联 style 上会被当 px 放大 → 老板实测「大的吓人、盖住右上角一半」）；
          ④ 老板逐条实测定的口径：right:8px（左移 8）、top:10px、图标本体 20px、垂直压扁到 15px；
          ⑤ 2026-09-12 老板定：**业务员首页也放一模一样的一个** → 去掉 wx:if，老板端/业务员端都显示。
             （两端共用同一个 .head 头部区域、右上角坐标相同，所以一处改动两端自然一致。） -->
  <view style="position:absolute;left:auto;right:8px;top:10px;z-index:999;width:20px;height:20px">
    <button open-type="share" style="width:20px;height:20px;min-width:0;padding:0;margin:0;background:transparent;border:none;border-radius:0;line-height:0;overflow:visible">
      <image src="/images/share-icon.png" mode="aspectFit" style="width:20px;height:20px;display:block;transform:scaleY(.75);transform-origin:top"></image>
    </button>
  </view>

  <view class="head">
    <image class="head-logo" src="{{logoUrl}}" mode="aspectFit" binderror="onLogoError"></image>
    <view class="head-txt">
      <view class="hi">你好，{{user.name}}<text class="boss-crown" wx:if="{{bossMode}}"> 👑</text></view>
      <view class="pep"><text class="pep-t">{{pepText}}</text><text class="pep-e">{{pepEmoji}}</text></view>
    </view>
  </view>

  <view class="sub-banner" wx:if="{{!bossMode && showSubBanner}}" bindtap="subscribe">
    <text>📣 订阅"新任务提醒"，来单不耽误</text>
    <view class="x" catchtap="hideSubBanner">✕</view>
  </view>

  <!-- 老板模式（2026-09-09 §7.13）：数字卡带 -->
  <view class="boss-stats" wx:if="{{bossMode}}">
    <view class="bs"><view class="bs-n">{{bossStats.todayDone}}/{{bossStats.todayTotal}}</view><view class="bs-l">今日完成</view></view>
    <view class="bs"><view class="bs-n c-blue">{{bossStats.ongoing}}</view><view class="bs-l">拜访中</view></view>
    <view class="bs"><view class="bs-n c-orange">{{bossStats.online}}</view><view class="bs-l">在线</view></view>
    <view class="bs"><view class="bs-n c-red">{{bossStats.review}}</view><view class="bs-l">待审核</view></view>
  </view>

  <!-- 今日总览条（2026-09-10 质感升级新增：数据取自已有 bossStats，无云端改动） -->
  <view class="overview" wx:if="{{bossMode}}">
    <view class="ov-ic">📡</view>
    <view class="ov-tx">
      <view class="ov-t1">今日战况</view>
      <view class="ov-t2">{{bossNews}}</view>
    </view>
  </view>

  <view class="hero" wx:if="{{!bossMode}}">
    <view class="h1">{{dateText}}</view>
    <view class="hring" wx:if="{{cardMode === 'today'}}">
      <canvas canvas-id="ringCanvas" class="ring-canvas"></canvas>
      <view class="pct">{{todayPct}}%</view>
    </view>
    <view class="hbody">
      <block wx:if="{{cardMode === 'today'}}">
        <view class="big">{{todayTotal}}<text class="u">家</text></view>
        <view class="sub">已完成 {{todayDone}} 家 · 还有 {{todayLeft}} 家在等你 🔥</view>
        <view class="go" bindtap="goTodayTask">开始今天的工作 →</view>
      </block>
      <block wx:elif="{{cardMode === 'rest'}}">
        <view class="big emoji-big">☕</view>
        <view class="sub">今日无拜访安排，休息一下</view>
        <view class="go" bindtap="goAllTasks">查看我的任务 →</view>
      </block>
      <block wx:elif="{{cardMode === 'allDone'}}">
        <view class="big emoji-big">🎉</view>
        <view class="sub">任务全部完成，等待新任务派发</view>
        <view class="go" bindtap="goAllTasks">查看全部任务 →</view>
      </block>
      <block wx:else>
        <view class="big emoji-big">📋</view>
        <view class="sub">等待管理员派发第一个任务</view>
        <view class="go" bindtap="goAllTasks">查看全部任务 →</view>
      </block>
    </view>
  </view>

  <view class="sec-t">
    <view class="st-t">{{bossMode ? '全部任务' : '我的任务'}}</view>
    <view class="st-more" bindtap="goAllTasks" wx:if="{{!bossMode}}">全部 ›</view>
  </view>

  <view class="task-card {{item.status === 'done' ? 'done' : ''}} {{item.hasOngoing ? 'ongoing' : ''}}" wx:for="{{showTasks}}" wx:key="_id" bindtap="goTask" data-id="{{item._id}}">
    <view class="row1">
      <view class="tname">{{item.name}}<text class="towner" wx:if="{{bossMode}}"> · {{item.salesmanName}}</text></view>
      <view class="state {{item.status === 'done' ? 'done' : (item.status === 'reviewing' ? 'review' : (item.expired ? 'expired' : 'going'))}}"
            style="{{item.purpose === 'develop' ? 'background:#E8F1FD;color:#2F80ED' : ''}}">{{item.purpose === 'develop' ? '🌱 新客开发' : (item.status === 'done' ? '已完成' : (item.status === 'reviewing' ? '审核中' : (item.expired ? '已过期' : '进行中')))}}</view>
    </view>
    <view class="row2">
      <text>已拜访 {{item.visited}} / {{item.total}} 家</text>
      <text>截止 {{item.deadline}}</text>
    </view>
    <view class="pbar"><view class="pfill" style="width:{{item.percent}}%;{{item.purpose === 'develop' ? 'background:linear-gradient(90deg,#5B9DFF,#2F80ED)' : ''}}"></view></view>
  </view>

  <view class="empty" wx:if="{{!loading && !tasks.length}}">暂无任务，等管理员派发后即可看到</view>
  <view class="loading" wx:if="{{loading}}">加载中…</view>

  <!-- 底部 Tab 栏已迁移到自定义组件 custom-tab-bar（2026-09-10 老板拍板：tab 页常驻，切页不再重绘底部栏 → 消除白闪） -->

  <!-- 老板欢迎仪式（2026-09-10：全屏 canvas「👑 欢迎老板」礼花，播完自动消失，不挡操作） -->
  <canvas type="2d" id="welcomeCv" wx:if="{{welShow}}" style="position:fixed;left:0;top:0;width:100vw;height:100vh;z-index:9999;pointer-events:none"></canvas>
</view>
