/* 我的记事 · 列表（2026-09-28 老板定：只存本机）
   视觉沿用项目规范：暖白底 + 纯白卡 + 品牌橙点缀；尺寸用 px（与其它页面一致）
   底部留白 100px：给固定的「＋ 记一笔」让位，别挡住最后一条记事 */

.page { padding: 14px 14px 100px; background: var(--bg); min-height: 100vh; box-sizing: border-box; }

/* ⭐ 新建入口（2026-09-28 晚老板定：**悬空 + 虚线橙边橙字**）
   —— 不要底部白底板、不要橙色实心；按钮自己一条，浮在内容之上 */
.newbar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 20;
  padding: 10px 14px calc(10px + env(safe-area-inset-bottom)); }
.newbar .nb-btn { height: 50px; border-radius: 14px; display: flex; align-items: center; justify-content: center;
  background: #fff; border: 1px dashed var(--primary); color: var(--primary);
  font-size: 16.5px; font-weight: 700; letter-spacing: 1px;
  box-shadow: 0 6px 18px rgba(31, 36, 48, .10); }

/* 客户过滤条（从客户详情页进来才有） */
.filter { display: flex; align-items: center; gap: 7px; background: #FFF7F2; border: 1px solid #F7E4D8;
  border-radius: 12px; padding: 9px 12px; margin-bottom: 11px; font-size: 12.5px; }
.filter .f-t { color: #B4441B; font-weight: 700; flex: 0 0 auto; }
.filter .f-n { flex: 1; min-width: 0; color: var(--sub); font-weight: 600;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.filter .f-x { flex: 0 0 auto; color: var(--primary); font-weight: 700; }

/* 空态（淡灰；与客户详情页 .empty4 同款口径） */
.empty4 { padding: 60px 26px; text-align: center; }
.empty4 .e4-t { font-size: 14.5px; color: #AEB6C2; font-weight: 600; }
.empty4 .e4-s { margin-top: 8px; font-size: 12.5px; color: #C2C9D4; line-height: 1.6; }

/* 记事卡 */
.ncard { background: #fff; border-radius: 15px; padding: 13px 14px; margin-bottom: 10px;
  border: 1px solid #EFF1F5; box-shadow: 0 2px 8px rgba(31, 36, 48, .05); }
.n-t { display: flex; align-items: center; gap: 6px; }
.n-t .n-tt { flex: 1; min-width: 0; font-size: 15px; font-weight: 700; color: var(--ink);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.n-t .n-cust { flex: 0 0 auto; font-size: 10.5px; font-weight: 700; color: var(--primary-deep);
  background: #FFF1EA; border-radius: 999px; padding: 2px 8px; }
.n-x { margin-top: 4px; font-size: 12.5px; color: var(--sub); line-height: 1.55;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.thumbs { display: flex; gap: 6px; margin-top: 9px; }
.thumbs .th { width: 64px; height: 48px; border-radius: 9px; background: #F2F4F7; }
.n-m { margin-top: 8px; display: flex; align-items: center; gap: 10px; font-size: 11px; color: #8A93A1; }
