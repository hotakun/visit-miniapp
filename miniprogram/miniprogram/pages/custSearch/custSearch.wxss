page { background: #F6F7F9; }

.wrap { padding: 12px 14px 24px; box-sizing: border-box; }

.bar { display: flex; align-items: center; gap: 8px; }

.ipt {
  flex: 1;
  height: 40px;
  background: #fff;
  border: 1px solid #E3E8EF;
  border-radius: 10px;
  padding: 0 12px;
  font-size: 14px;
  box-sizing: border-box;
}

.go {
  height: 40px;
  line-height: 40px;
  padding: 0 16px;
  border-radius: 10px;
  background: #F5531C;
  color: #fff;
  font-size: 14px;
  font-weight: 700;
}

.hint { font-size: 11.5px; color: #98A2AE; margin: 8px 2px 10px; }

.tip { color: #98A2AE; font-size: 13px; text-align: center; padding: 24px 0; }
.tip.err { color: #D64545; }

.list { background: #fff; border-radius: 12px; overflow: hidden; }

.row { padding: 12px 14px; border-bottom: 1px solid #F0F2F5; }
.row:last-child { border-bottom: none; }

.r1 { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }

.n { font-size: 14.5px; font-weight: 700; color: #1F2733; }

.code {
  font-size: 11px;
  color: #7A8490;
  background: #F2F4F7;
  border-radius: 4px;
  padding: 1px 5px;
}

.r2 { font-size: 12px; color: #7A8490; margin-top: 4px; line-height: 1.45; }
