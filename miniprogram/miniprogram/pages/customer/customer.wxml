<!-- 客户详情（2026-09-25 改造：**真数据页**）
     数据来自云函数 tasks 的 custDetail（一次返回档案 + 订单 + 明细 + 备注 + 拜访历史）；
     界面骨架照 _scratch/客户详情页-A-手机演示.html 那套 **7 卡固定出现**（没数据给空态，不整卡消失）。
     铁律：WXML 只用 view / text，禁止 HTML 标签 -->
<!-- 加载中 / 加载失败：d 为空时不渲染页面（也避免闪出假数据）
     2026-09-25：加载失败时**把原因显示出来**（原来只弹 toast，会被后续的 hideLoading 盖掉，只看到"一直加载中"没法排查） -->
<view class="page-loading" wx:if="{{!d}}">
  <text class="pl-t" wx:if="{{!loadErr}}">正在加载客户资料…</text>
  <text class="pl-t" wx:else>加载失败</text>
  <text class="pl-s" wx:if="{{loadErr}}">{{loadErr}}</text>
  <text class="pl-s" wx:else>若长时间没反应，返回上一页重进</text>
</view>
<view class="page" wx:else>

  <!-- ===================== 店名卡（不折叠） ===================== -->
  <!-- ⭐ 2026-09-27：入商城辉光（已入=淡橙一圈 / 未入=天蓝一圈）+「新店」蓝胶囊（设计文档 §二 0） -->
  <view class="head {{d.hasMall ? 'is-mall' : 'is-new'}}">
    <view class="hrow1">
      <text class="nm">{{d.name}}</text>
      <text class="tag new" wx:if="{{d.newShop}}">新店</text>
      <text class="tag old" wx:if="{{d.listedYears >= 3}}">收录 {{d.listedYears}} 年</text>
      <!-- ⭐ 2026-09-28 晚 老板定：「⏳ 待商城建档」（业务员现场用「加新店」录的店，商城侧还没有档案） -->
      <text class="tag pend" wx:if="{{d.mallPending}}">⏳ 待商城建档</text>
    </view>
    <view class="meta">
      <view class="mline">
        <text class="ic">📍</text><text class="tx">{{d.addr}}</text>
      </view>
      <view class="mline hours">
        <text class="ic">🕙</text>
        <!-- 2026-09-25 老板定：**营业状态放最前面**（这行长了会折行，状态在最前就总是一眼可见）；
             营业时间里的换行符已在 buildD 的 flatHours() 里折成空格 -->
        <text class="tx"><text wx:if="{{d.status}}" class="strong">{{d.status}}</text><text wx:if="{{d.status}}"> · </text>{{d.hours}}</text>
      </view>
      <view class="mline cat" wx:if="{{d.cat || d.rank}}">
        <text class="ic">🏷</text>
        <text class="tx">{{d.cat}}</text>
        <text class="rk" wx:if="{{d.rank}}">🏆 {{d.rank}}</text>
      </view>
    </view>
    <view class="telrow">
      <view class="call">📞</view>
      <view class="pwrap">
        <view class="ph">{{d.tel}}</view>
        <view class="lb">联系人：{{d.contact}}</view>
      </view>
      <!-- ⭐ 2026-09-28 晚老板定：这里改成「**快速记事**」入口（文字**上下两层**：上面「快速」下面「记事」），
           尺寸仍是原来那个报错方块的 44×44。
           · 原「📍 报错」方块**已移到下面「📍 商圈与位置」卡的小地图下方**（与「导航」并排）。
           · 点击 = **以本客户为对象写一条记事**（标题带店名、关联客户已挂好）；
             记事**只存本机**（老板 2026-09-28 拍板），落地见 pages/notes/editor/。 -->
      <view class="notebtn" bindtap="goQuickNote">
        <text>快速</text><text>记事</text>
      </view>
    </view>

    <!-- ⭐ 本机「我的记事 · N 条」（2026-09-28）：**真在本机记过事才出现** ——
         0 条时旁边就是「快速记事」，不重复占位（老板要简洁）；点它进列表只看这一家。 -->
    <view class="noterow" wx:if="{{notesN > 0}}" bindtap="goNotes">
      <text class="nr-ic">📝</text>
      <text class="nr-t">我的记事 · {{notesN}} 条</text>
      <text class="nr-go">查看 ›</text>
    </view>
  </view>

  <!-- ===================== 🏪 商城信息 ===================== -->
  <view class="card k-mall {{open.mall ? '' : 'collapsed'}}">
    <view class="ch" data-k="mall" bindtap="toggle">
      <text class="ci">🏪</text><text class="t">商城信息</text>
      <text class="sub">{{d.mallSub}}</text>
      <text class="chev">⌄</text>
    </view>
    <view class="cb">
      <!-- ⭐ 2026-09-28 晚老板定：**未加入商城就什么都不摆** ——
           注册商城时间 / 签约业务员 / 最近下单 / 最近浏览 这些"肯定没有"，没有就不显示出来；
           只留下面的「📷 门店照片」三格，业务员照样能加照片。
           （原来是"没有也说一句"：「这家还没加入商城／到店可以推动加入（拜访结果里选加入商城）」→ 删）
           ⚠️ 所以 `wx:if` 挂 hasMall；未入商城由店名卡的辉光表达，不靠文字。 -->
      <block wx:if="{{d.hasMall}}">
        <view class="r" wx:for="{{d.mallRows}}" wx:key="*this">
          <text class="k">{{item[0]}}</text>
          <text class="v {{item[0] === '最近下单' ? 'warn' : ''}}">{{item[1]}}</text>
        </view>
      </block>
      <view class="subsec">📷 门店照片</view>
      <view class="shotrow">
        <view class="shot3 {{d.photos[index] ? '' : 'empty'}}"
              wx:for="{{d.photos}}" wx:key="index"
              data-i="{{index}}" data-url="{{item}}"
              bindtap="{{d.photos[index] ? 'openPhoto' : 'takePhoto'}}">
          <image class="shot-img" wx:if="{{d.photos[index]}}" src="{{item}}" mode="aspectFill"></image>
          <block wx:else>
            <text class="cam3">📷</text><text class="t3">拍照</text>
          </block>
        </view>
      </view>
      <!-- ⭐ 2026-10-03：「加新店」现场录的音（customers.audios）—— 业务员建店时录的，老板 / 同事也能听。
           样式直接复用拜访历史那套（.hrec/.hplay/.hrec-t/.hrec-bar，暖底圆角，视觉一致）；
           没有录音时 d.siteRec 为 null → 整块不出现（不留空位）。 -->
      <view class="hrec" wx:if="{{d.siteRec}}">
        <view class="hplay" bindtap="playSiteRec">{{d.siteRec.playing ? '❚❚' : '▶'}}</view>
        <text class="hrec-t">现场录音 {{d.siteRec.dur}}</text>
        <view class="hrec-bar"><view class="hrec-i" style="width:{{d.siteRec.pct}}%"></view></view>
      </view>
    </view>
  </view>

  <!-- ===================== 📦 购买记录 ===================== -->
  <view class="card k-purchase {{open.purchase ? '' : 'collapsed'}}">
    <view class="ch" data-k="purchase" bindtap="toggle">
      <text class="ci">📦</text><text class="t">购买记录</text>
      <text class="sub">{{d.orders.length ? ('累计 ' + d.purchase.total + ' · ' + d.purchase.amount) : '暂无订单'}}</text>
      <text class="chev">⌄</text>
    </view>
    <view class="cb">
      <!-- ⭐ 2026-09-27：没下过单 → 淡灰空态（设计文档 §三） -->
      <view class="empty4" wx:if="{{!d.orders.length}}">
        <text class="e4i">📦</text>
        <text class="e4t">还没有下过单</text>
        <text class="e4s">我们这边没有这家的下单记录 —— 到店先聊供货</text>
      </view>
      <block wx:else>
      <view class="r">
        <text class="k">最近下单</text><text class="v warn">{{d.purchase.last}}</text>
      </view>
      <view class="subfold">
        <text class="fold-t">常买（次数）</text>
        <text class="fold-mini" wx:for="{{d.purchase.freq}}" wx:if="{{index < 2}}" wx:key="*this">{{item[0]}} ×{{item[1]}}</text>
      </view>
      <view class="chips" style="margin-top:6px">
        <text class="chip" wx:for="{{d.purchase.freq}}" wx:key="*this">{{item[0]}} ×{{item[1]}}</text>
      </view>
      <view class="r" style="margin-top:9px;border-top:1px solid var(--line);border-bottom:none">
        <text class="k">最近一单</text><text class="v mut">{{d.purchase.lastItems}}</text>
      </view>
      <view class="btn-all" bindtap="openSheet">查看全部 {{d.orders.length}} 单 ›</view>
      <view class="warnbox" wx:if="{{d.purchase.note}}">💡 {{d.purchase.note}}</view>
      </block>
    </view>
  </view>

  <!-- ===================== 📊 平台口碑 ===================== -->
  <view class="card k-rate {{open.rate ? '' : 'collapsed'}}">
    <view class="ch" data-k="rate" bindtap="toggle">
      <text class="ci">📊</text><text class="t">平台口碑</text>
      <text class="sub">{{d.rateSub}}</text>
      <text class="chev">⌄</text>
    </view>
    <view class="cb">
      <!-- ⭐ 2026-09-28 晚老板定：**没评分就什么都不说** ——
           原来这里写「平台没有收录这家的评分／别把"没评分"当缺点」，会让人误以为平台没有这家店的信息
           （其实都有，只是这家还没评分）→ 空态整块删掉：**有评分才显示评分**，没评分就直接进下面的招牌菜。 -->
      <block wx:if="{{d.rate}}">
        <view class="rate">
          <text class="num">{{d.rate}}</text><text class="of">/5</text>
          <text class="txt">{{d.rateTxt}}</text>
        </view>
        <view class="bars">
          <view class="bline" wx:for="{{d.bars}}" wx:key="*this">
            <text class="bk">{{item[0]}}</text>
            <view class="bar"><view class="bar-i" style="width:{{item[2]}}%"></view></view>
            <text class="bn">{{item[1]}}</text>
          </view>
        </view>
        <view class="r" wx:for="{{d.extra}}" wx:key="*this">
          <text class="k">{{item[0]}}</text><text class="v">{{item[1]}}</text>
        </view>
        <view class="r"><text class="k">榜单</text><text class="v gold">{{d.rank}}</text></view>
      </block>
      <view class="subsec">🍜 招牌菜</view>
      <view class="chips">
        <text class="chip" wx:for="{{d.dishes}}" wx:key="*this">{{item}}</text>
        <view class="empty3" bindtap="openAdd" data-kind="dish">
          <text class="addtap">＋</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ===================== 🛎 服务与设施 ===================== -->
  <view class="card k-serv {{open.serv ? '' : 'collapsed'}}">
    <view class="ch" data-k="serv" bindtap="toggle">
      <text class="ci">🛎</text><text class="t">服务·位置</text>
      <text class="sub" wx:if="{{d.flags[1][1]}}">外卖 有</text>
      <text class="chev">⌄</text>
    </view>
    <view class="cb">
      <view class="kvrow">
        <view class="kv">
          <text class="flag {{item[1] ? 'y' : 'n'}}"
                wx:for="{{d.flags}}" wx:key="*this"
                data-name="{{item[0]}}" data-on="{{item[1]}}"
                bindtap="openFlag">{{item[0]}} {{item[1] ? '已开' : '未开'}}{{d.flagPending[item[0]] ? ' · 待审核' : ''}}</text>
        </view>
        <view class="plusbar" bindtap="openAdd" data-kind="fac">＋</view>
      </view>
      <view class="facsec" wx:if="{{d.fac.length}}">
        <view class="fack">配套·服务·设施</view>
        <view class="chips">
          <text class="chip" wx:for="{{d.fac}}" wx:key="*this">{{item}}</text>
        </view>
      </view>
      <view class="subsec">📍 商圈与位置<text class="cname">{{d.name}}</text></view>
      <view class="r"><text class="k">地址</text><text class="v mut">{{d.addr}}</text></view>
      <view class="r" wx:if="{{d.region}}"><text class="k">商圈</text><text class="v">{{d.region}}</text></view>
      <!-- ⭐ 2026-09-28 晚老板定：**商圈下方、地图上方**显示经纬度（纬度在前，项目口径）。
           修正模式下这里显示"地图中心"的新坐标 + 与原坐标的距离（fixLat/fixLng/fixDist 由 onRegionChange 填）。
           ⚠️ 沿革：09-25 这行在地图**下方**；09-28 晚删过一次；现在是**地图上方** —— 别再来回挪。 -->
      <view class="r" wx:if="{{d.lat}}">
        <text class="k">经纬度</text>
        <text class="v mut">{{fixing ? fixLat : d.lat}}, {{fixing ? fixLng : d.lng}}<text class="dist" wx:if="{{fixing && fixDist}}">　距原位置 {{fixDist}}</text></text>
      </view>
      <!-- 小地图（2026-09-13 老板要求加上）：以客户坐标为中心、不可拖、可缩 10~20 级、初始 16 级
           ⚠️ <map> 是原生组件，卡片折叠用的 CSS display:none 压不住它 → 必须用 wx:if 跟展开状态走
           2026-09-25 老板定：**打开 POI 标注**（enable-poi 原来是 false，地图上光秃秃的 —— 看不到餐饮/超市） -->
      <view class="cmap-wrap" wx:if="{{open.serv}}">
        <map class="cmap" id="cmap"
             latitude="{{centerLat || d.lat}}" longitude="{{centerLng || d.lng}}"
             scale="16" min-scale="10" max-scale="20"
             enable-scroll="{{fixing}}" enable-zoom="{{true}}"
             enable-rotate="{{false}}" enable-overlooking="{{false}}"
             show-location="{{false}}" enable-poi="{{true}}" markers="{{markers}}"
             bindregionchange="onRegionChange"
             polyline="{{polyline}}"></map>
        <!-- ⭐ 2026-09-28 晚老板定：小地图改成**凹下（内阴影）** —— 在地图**上面**叠一层透明 view 来画 inset 阴影。
             为什么不用 .cmap-wrap 的 inset、也不用 ::after：<map> 是绝对定位铺满容器的，写在容器上的内阴影会被地图盖住；
             而伪元素盖原生组件不如普通 view 稳（本页「聚火地图」badge 就是普通 view(z-index:9)，已验证能盖住地图）。
             z-index 2 低于 badge 的 9 → badge 仍浮在最上；pointer-events:none → 不挡地图的缩放操作。 -->
        <view class="cmap-in"></view>
        <!-- ⭐ 2026-09-28 晚新增：**地图中心图钉（只在修正模式显示）** —— 固定在地图正中，表示"取的就是这个点"。
             必须是普通 view（同 .cmap-in）；z-index 3 高于 .cmap-in(2)、低于 badge(9)；pointer-events:none 不挡拖动。
             ⚠️ **只有一个圆点**：**圆心 = 取的那个点**（老板 2026-09-28 问"到底以什么为中心"→ 原来那根
                细短线 .stem 已删，避免让人误以为取的是线尾）。 -->
        <view class="cmap-pin" wx:if="{{fixing}}"><view class="dot"></view></view>
        <!-- ⭐ 2026-09-28 晚老板定：修正模式的引导提示**贴小地图上边缘**。
             原来用的是 wx.showToast —— 屏幕正中一个胶囊，正好压住地图中心与红点（挡视线）。
             必须是普通 view 才能盖在原生 <map> 上（同 .cmap-in / .cmap-pin / .jh-badge）。 -->
        <view class="cmap-tip" wx:if="{{fixing}}">拖动地图，把红点对准门店位置</view>
        <!-- 2026-09-25 老板定：手机端地图也要去掉腾讯 logo/版本号、换成「聚火地图」。
             去 logo 用**裁剪法**：.cmap-wrap 加 overflow:hidden，.cmap 高度多出 40px → 底部 logo 区被裁掉。
             ⚠️ wx:if 必须留在**外层 wrapper** 上（卡片折叠靠它控制显隐，原生组件用 CSS 隐藏压不住）。 -->
    <!-- ⭐ 2026-09-27：腾讯地图 logo/审图号**恢复显示**（撤销裁剪法）；「聚火地图」badge 同时保留，
         位置改到**左上角**（腾讯 logo 在右下角，不能互相压）。 -->
        <view class="jh-badge">
          <view class="jh-compass"><view class="jh-needle"></view></view>
          <view class="jh-word">聚火地图</view>
        </view>
      </view>
      <!-- ↑ enable-poi 打开地图上的店铺 POI（2.14.0+）；必须写 Mustache 绑定，"true" 会被当字符串真值 -->
      <!-- ⭐ 2026-09-28 晚老板定：小地图下方**不再显示经纬度**（原来那行 `.coords` 已删），
           改成**两个精致小巧的按钮**并排：🧭 导航 / 📍 报错。
           · 导航 = wx.openLocation 打开微信内置地图（用户可一键跳高德/百度继续导航）；无坐标时不显示这一行；
           · 报错 = 复用原来的坐标报错弹层（openFix），入口从电话行挪到这里。 -->
      <!-- ⭐ 2026-09-28 晚老板定：小地图下方那一行按钮（都是 28px 高的小按钮，**精致小巧**）：
           · 左边：🧭 导航（wx.openLocation 打开微信内置地图，可一键跳高德/百度）
                   + 📍 报错（复用原弹层 —— 老板 2026-09-28 定「两个都留」）
           · 最右边：📍 修正 —— 点它进入**地图修正模式**：地图可拖 → 地图中心点即新坐标 →
             上方经纬度实时显示新坐标 + 与原坐标的距离 → 点「确定」自动提交后台审核。
             修正模式下：它变成「确定」，左边多出「取消」，导航/报错暂时隐藏。
           无坐标（d.lat 空）时整行不显示。 -->
      <view class="mapln" wx:if="{{d.lat}}">
        <block wx:if="{{!fixing}}">
          <view class="mbtn" bindtap="onNav">🧭 导航</view>
          <view class="mbtn warn" bindtap="openFix">📍 报错</view>
          <view class="mbtn warn ml" bindtap="startFix">修正</view>
        </block>
        <block wx:else>
          <view class="mbtn ml" bindtap="cancelFix">取消</view>
          <view class="mbtn ok" bindtap="confirmFix">确定</view>
        </block>
      </view>
    </view>
  </view>

  <!-- ===================== 📝 管理员备注 ===================== -->
  <view class="card remark {{open.remark ? '' : 'collapsed'}}">
    <view class="ch" data-k="remark" bindtap="toggle">
      <text class="ci">📝</text><text class="t">管理员备注</text>
      <text class="sub">{{d.remarks.length ? (d.remarks.length + ' 条') : '暂无'}}</text>
      <text class="chev">⌄</text>
    </view>
    <view class="cb">
      <!-- ⭐ 2026-09-27：没备注 → 淡灰空态 -->
      <view class="empty4" wx:if="{{!d.remarks.length}}">
        <text class="e4i">📝</text>
        <text class="e4t">还没有备注</text>
        <text class="e4s">管理员在后台加备注，这里就能看到</text>
      </view>
      <block wx:else>
        <view class="rkrow" wx:for="{{d.remarks}}" wx:key="d">
          <text class="rkd">{{item.d}}</text><text class="rkt">{{item.t}}</text>
        </view>
      </block>
    </view>
  </view>

  <!-- ===================== 🕑 拜访历史 ===================== -->
  <view class="card hist {{open.hist ? '' : 'collapsed'}}">
    <view class="ch" data-k="hist" bindtap="toggle">
      <text class="ci">🕑</text><text class="t">拜访历史</text>
      <text class="sub">{{d.history.length ? (d.history.length + ' 次') : '暂无'}}</text>
      <text class="chev">⌄</text>
    </view>
    <view class="cb">
      <!-- ⭐ 2026-09-27：没拜访过 → 淡灰空态 -->
      <view class="empty4" wx:if="{{!d.history.length}}">
        <text class="e4i">🕑</text>
        <text class="e4t">暂无拜访记录</text>
        <text class="e4s">第一次上门后，这里会留下记录</text>
      </view>
      <view class="tl-item {{item.latest ? 'latest' : ''}}" wx:for="{{d.history}}" wx:key="md">
        <view class="hrow">
          <text class="hr-tag">{{item.tag}}</text>
          <text class="hm">{{item.md}} · {{item.who}}</text>
          <text class="hd">{{item.mins}}</text>
        </view>
        <view class="htxt" wx:if="{{item.txt}}">{{item.txt}}</view>
        <view class="htxt samp" wx:if="{{item.samp}}">📦 样品：{{item.samp}}</view>

        <!-- ① 拜访录音（⭐ 2026-09-27：**真音频播放**；没有录音 → 这一块不出现） -->
        <view class="hrec" wx:if="{{item.rec}}">
          <view class="hplay" data-i="{{index}}" bindtap="playRec">{{item.rec.playing ? '❚❚' : '▶'}}</view>
          <text class="hrec-t">拜访录音 {{item.rec.dur}}</text>
          <view class="hrec-bar"><view class="hrec-i" style="width:{{item.rec.pct}}%"></view></view>
        </view>
        <!-- ② 录音转文字 -->
        <view class="htrans" wx:if="{{item.rec && item.rec.txt}}">
          <view class="htrans-h">🎙 录音转文字</view>
          <view class="htrans-b">{{item.rec.txt}}</view>
        </view>
        <!-- ③ 现场拍的 3 张照片（点开放大） -->
        <view class="hshots" wx:if="{{item.shots}}">
          <view class="hshot" wx:for="{{item.shots}}" wx:for-item="s" wx:for-index="si" wx:key="*this"
                data-url="{{s}}" bindtap="openPhoto">
            <image class="hshot-img" src="{{s}}" mode="aspectFill"></image>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- ===================== 底部悬浮：开始拜访 =====================
       2026-09-25 老板定：这家**正在拜访中** → 按钮变**蓝色「拜访中」**（橙色 → 蓝色，文案同步改） -->
  <view class="fab-wrap">
    <view class="fab {{d.visiting ? 'fab-on' : ''}}" bindtap="goVisit">{{d.visiting ? '拜访中' : '开始拜访'}}</view>
  </view>

  <!-- ===================== 录入弹层 ===================== -->
  <view class="mask" wx:if="{{addShow}}" bindtap="addNo">
    <view class="box" catchtap="noop">
      <view class="box-t">{{addTitle}}</view>
      <view class="box-s">平台没收录的，到店问一句就能补上</view>
      <input class="box-i" placeholder="{{addPh}}" value="{{addVal}}" bindinput="addInput" />
      <view class="box-btns">
        <view class="bbtn ghost" bindtap="addNo">取消</view>
        <view class="bbtn main" bindtap="addYes">保存</view>
      </view>
    </view>
  </view>

  <!-- ===================== 团购/外卖 确认弹层 ===================== -->
  <view class="mask" wx:if="{{flagShow}}" bindtap="flagNo">
    <view class="box" catchtap="noop">
      <view class="box-t">把「{{flagName}}」标记为「{{flagTo ? '已开' : '未开'}}」？</view>
      <view class="box-s">到店了解到的实际情况，点确定就改过来</view>
      <view class="box-btns">
        <view class="bbtn ghost" bindtap="flagNo">取消</view>
        <view class="bbtn main" bindtap="flagYes">确定</view>
      </view>
    </view>
  </view>

  <!-- ===================== 📍 坐标报错弹层（2026-09-27 新增）===================== -->
  <view class="mask" wx:if="{{fixShow}}" bindtap="fixClose">
    <view class="box" catchtap="noop">
      <view class="box-t">📍 报告坐标不准</view>
      <view class="box-s">走到店门口再提交 —— 管理员审核后会把坐标改准</view>
      <input class="box-i" placeholder="哪里不准？（可不填，如：这家搬走了 / 定位差很远）"
             value="{{fixNote}}" bindinput="fixNoteIn" maxlength="100" />
      <view class="fixshotrow">
        <view class="fixshot" wx:for="{{fixShots}}" wx:key="index" data-i="{{index}}" bindtap="fixShot">
          <image class="fixshot-img" wx:if="{{item}}" src="{{item}}" mode="aspectFill"></image>
          <block wx:else>
            <text class="cam3">📷</text><text class="t3">拍照</text>
          </block>
        </view>
      </view>
      <view class="box-btns">
        <view class="bbtn ghost" bindtap="fixClose">取消</view>
        <view class="bbtn main" bindtap="submitFix">提交报错</view>
      </view>
    </view>
  </view>

  <!-- ===================== 购买记录抽屉 ===================== -->
  <view class="sheet" wx:if="{{sheetShow}}" bindtap="closeSheet">
    <view class="sheet-box" catchtap="noop">
      <view class="sheet-h">
        <text class="sheet-t">购买记录 · {{d.name}}</text>
        <text class="sheet-x" bindtap="closeSheet">✕</text>
      </view>
      <scroll-view class="sheet-b" scroll-y>
        <view class="sheet-note">共 {{d.orders.length}} 单 · 合计 {{d.purchase.amount}}（点一单看明细）</view>
        <block wx:for="{{d.orders}}" wx:key="d">
          <view class="ord" data-i="{{index}}" bindtap="toggleOrder">
            <text class="ord-d">{{item.d}}</text>
            <text class="ord-s">{{item.items[0][0]}} 等</text>
            <text class="ord-a">¥{{item.a}}</text>
            <text class="ord-v">{{item.open ? '⌄' : '›'}}</text>
          </view>
          <view class="ord-det" wx:if="{{item.open}}">
            <view class="ord-item" wx:for="{{item.items}}" wx:for-item="it" wx:key="*this">
              <text class="oi-n">{{it[0]}}</text>
              <text class="oi-q">{{it[1]}}</text>
              <text class="oi-m">¥{{it[3]}}</text>
            </view>
          </view>
        </block>
      </scroll-view>
    </view>
  </view>

  <!-- ===================== 大图查看 ===================== -->
  <view class="viewer" wx:if="{{viewerShow}}" bindtap="closePhoto">
    <image class="viewer-img" src="{{viewerUrl}}" mode="aspectFit"></image>
    <view class="viewer-x">关闭</view>
  </view>

</view>
