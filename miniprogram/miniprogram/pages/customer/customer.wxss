.page { padding: 18px 18px 120px; }
.hero { display: flex; align-items: center; gap: 10px; }
.nm { font-size: 22px; font-weight: 800; }
.tag { font-size: 12px; font-weight: 700; padding: 5px 10px; border-radius: 999px; }
.addr { margin-top: 6px; font-size: 12.5px; color: var(--sub); }
.phoneRow { display: flex; align-items: center; gap: 11px; margin-top: 14px; }
.call { width: 50px; height: 50px; border-radius: 50%; background: var(--green); color: #fff; font-size: 20px; display: flex; align-items: center; justify-content: center; box-shadow: 0 8px 18px rgba(22,163,74,.35); }
.call.none { background: #E7E9ED; box-shadow: none; }
.pwrap { flex: 1; min-width: 0; }
.ph { font-size: 17px; font-weight: 800; }
.ph.none { color: var(--sub); }
.lb { margin-top: 2px; font-size: 11px; color: var(--sub); font-weight: 600; }
.card { margin-top: 14px; padding: 15px 16px; background: #fff; border-radius: 16px; box-shadow: 0 2px 10px rgba(31,36,48,.06); }
.ct { font-size: 13px; font-weight: 800; }
.rows { margin-top: 8px; }
.r { display: flex; justify-content: space-between; padding: 8.5px 0; font-size: 13.5px; border-bottom: 1px dashed var(--line); }
.r:last-child { border-bottom: none; }
.k { color: var(--sub); font-weight: 600; }
.v { font-weight: 700; }
.v.warn { color: var(--primary-deep); }
.v.blue { color: var(--blue); }
.remark { margin-top: 8px; font-size: 13px; color: #4A5360; line-height: 1.7; }
.tl { margin-top: 18px; }
.tl-t { font-size: 15px; font-weight: 800; margin-bottom: 10px; }
.tl-item { background: #fff; border-radius: 16px; padding: 13px 15px; margin-bottom: 10px; box-shadow: 0 2px 10px rgba(31,36,48,.06); opacity: .85; }
/* 最新一次拜访：浅橙边框全饱和，其余卡片弱化，注意力一眼落在最新卡片上 */
.tl-item.latest { background: #fff; border: 1.5px solid #FFC9A8; opacity: 1; }
/* 拜访中：蓝色辉光边缘（放 latest 之后，拜访中且最新的记录蓝框优先），与任务页拜访中卡片统一（老板 2026-09-06 定） */
.tl-item.ongoing { border: 1.5px solid var(--blue); box-shadow: 0 2px 12px rgba(47,128,237,.16); opacity: 1; }
.hrow { display: flex; align-items: center; gap: 8px; font-size: 12.5px; font-weight: 700; }
.hr-tag { padding: 3px 9px; border-radius: 999px; background: var(--primary-tint); color: var(--primary-deep); }
.hr-tag.ong { background: var(--blue-tint); color: var(--blue); }
.hm { flex: 1; }
.hd { color: var(--sub); font-size: 11px; font-weight: 600; }
.htxt { margin-top: 7px; font-size: 13px; color: #4A5360; line-height: 1.6; }
.hsamp { margin-top: 5px; font-size: 12px; color: var(--sub); font-weight: 600; }
/* 现场证据（2026-09-07）：照片缩略行 + 录音播放控件（2026-09-08 加进度条） */
.hev { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
.hev-pic { width: 84px; height: 63px; border-radius: 9px; background: #F0F2F5; }
.hev-audio { display: flex; align-items: center; gap: 8px; margin-top: 8px; padding: 5px 10px; border-radius: 12px; background: var(--blue-tint); }
.ha-play { width: 30px; height: 30px; border-radius: 50%; background: #fff; color: var(--blue); display: flex; align-items: center; justify-content: center; font-size: 12px; flex-shrink: 0; box-shadow: 0 1px 4px rgba(31,36,48,.14); }
.hev-audio.on { background: #DDEBFD; }
.hev-audio.on .ha-play { background: var(--blue); color: #fff; }
.ha-slider { flex: 1; min-width: 0; margin: 0 2px; }
.ha-time { font-size: 10.5px; color: var(--sub); font-weight: 700; flex-shrink: 0; font-variant-numeric: tabular-nums; }
.empty { text-align: center; color: var(--sub); font-size: 13px; margin-top: 16px; }
/* ===== 语音转写（2026-09-11 M2b 小步）===== */
.tr-row { display: flex; align-items: center; gap: 7px; margin-top: 8px; flex-wrap: wrap; }
.tr-pill { font-size: 11.5px; font-weight: 800; padding: 4px 11px; border-radius: 999px; white-space: nowrap; flex-shrink: 0;
           box-shadow: inset 0 1px 0 rgba(255,255,255,.9), 0 1px 2px rgba(23,30,44,.08); }
.tr-pill.processing { background: linear-gradient(180deg,#FFF1E4,#FFE0CC); color: #C2360A; }
.tr-pill.done { background: linear-gradient(180deg,#E9F8EF,#D8F0E2); color: #117A38; }
.tr-pill.partial { background: linear-gradient(180deg,#FDF3E2,#FBE9CE); color: #B97A0B; }
.tr-pill.failed { background: linear-gradient(180deg,#FCEBEC,#FADCDE); color: #C93A40; }
.tr-n { font-size: 11px; color: var(--sub); font-weight: 700; }
.tr-prev { margin-top: 6px; font-size: 12.5px; color: #4A5360; line-height: 1.65;
           display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
/* 全文弹层（复用 .c-mask / .c-box）*/
.tr-sub { margin-top: 4px; font-size: 11.5px; color: var(--sub); font-weight: 600; text-align: center; }
.tr-body { margin-top: 11px; max-height: 240px; overflow: auto; background: #F7F8FA; border: 1px solid var(--line);
           border-radius: 12px; padding: 11px 12px; font-size: 13px; line-height: 1.75; color: #333A44; white-space: pre-wrap; }
.tr-btns { display: flex; gap: 10px; margin-top: 12px; }
.tr-btn { flex: 1; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: 700; }
.tr-btn.ghost { background: #F0F2F5; color: #4A5360; }
.tr-btn.main { background: linear-gradient(135deg,#FF7A3D,#F5531C); color: #fff; }
.foot { position: fixed; left: 0; right: 0; bottom: 0; padding: 12px 18px 24px; display: flex; align-items: center; gap: 10px; background: linear-gradient(180deg, rgba(246,247,249,0), #F6F7F9 30%); }
.posfix { width: 42px; height: 42px; border-radius: 11px; background: var(--blue-tint); color: var(--blue); font-size: 9px; font-weight: 700; display: flex; flex-direction: column; align-items: center; justify-content: center; flex-shrink: 0; }
.posfix.off { background: #F0F1F4; color: var(--sub); }
.cfa { margin-left: 8px; font-size: 11px; font-weight: 700; color: #B97A0B; background: #FCF3E0; border-radius: 999px; padding: 3px 9px; flex-shrink: 0; }
/* 坐标报错确认弹窗 */
.c-mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; background: rgba(31,36,48,.5); display: flex; align-items: center; justify-content: center; z-index: 99; padding: 0 34px; }
.c-box { width: 100%; max-width: 320px; background: #fff; border-radius: 18px; padding: 20px 18px 16px; box-shadow: 0 20px 60px rgba(0,0,0,.25); }
.c-box .ct { font-size: 16px; font-weight: 800; text-align: center; margin-bottom: 14px; }
.crow { display: flex; align-items: center; gap: 10px; padding: 9px 0; }
.cic { width: 38px; height: 38px; border-radius: 11px; display: flex; align-items: center; justify-content: center; font-size: 16px; flex-shrink: 0; }
.cic.loc { background: var(--blue-tint); }
.cic.loc.used { background: #E5E8EC; color: #9AA1AB; }
.clb { flex: 1; font-size: 13px; font-weight: 700; word-break: break-all; }
.csl { font-size: 12px; color: var(--sub); font-weight: 600; }
.c-note { width: 100%; box-sizing: border-box; background: #F7F8FA; border: 1px solid var(--line); border-radius: 11px; height: 84px; line-height: 1.6; padding: 11px 12px; font-size: 13px; margin-top: 6px; }
/* 照片区演示占位（二期替换为真拍照） */
.c-photos { display: flex; gap: 10px; margin-top: 4px; justify-content: space-between; }
/* 全固定像素（2026-09-08 老板定）：弹窗内容宽 284px，三格 88×66px 写死（88*3+10*2=284 正好一行） */
.c-ph { position: relative; width: 88px; height: 66px; flex: none; border-radius: 11px; background: #F7F8FA; overflow: hidden; box-sizing: border-box; }
.c-ph.has { background: #EDEFF2; }
.c-ph-img { position: absolute; left: 0; top: 0; width: 100%; height: 100%; display: block; }
.c-ph-empty { position: absolute; left: 0; top: 0; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; border: 1.5px dashed #D5DAE0; border-radius: 11px; box-sizing: border-box; color: #B7BEC7; }
.c-ph-empty.busy { opacity: .6; }
.c-ph-ic { font-size: 20px; opacity: .45; }
.c-ph-del { position: absolute; top: 4px; right: 4px; width: 20px; height: 20px; line-height: 19px; text-align: center; background: rgba(0,0,0,.55); color: #fff; border-radius: 50%; font-size: 10px; font-weight: 700; }
.c-ph-tip { margin-top: 8px; font-size: 11.5px; color: var(--sub); font-weight: 600; text-align: center; }
.c-box .btn-primary { height: 46px; margin-top: 10px; }
/* 拜访中：开始拜访按钮变蓝（老板 2026-09-06 定），取消/提交后恢复主色 */
.btn-primary.visiting { background: var(--blue); }
.again { text-align: center; font-size: 13px; color: var(--sub); font-weight: 600; padding: 10px 0 0; }
