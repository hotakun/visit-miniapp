/* 自由拜访卡片页（2026-10-03） */
page { height: 100%; background: #E7EAF1; }
.page { position: relative; width: 100%; height: 100vh; overflow: hidden; }

.list { height: 100%; box-sizing: border-box; padding: 12px 12px 0; }
.pad { height: 84px; }   /* 给吸底按钮留位 */

/* 卡片 */
.fc { background: #fff; border-radius: 14px; padding: 13px 14px; margin-bottom: 10px;
  box-shadow: 0 1px 3px rgba(20,25,35,.06); position: relative; }
.r1 { display: flex; align-items: center; gap: 8px; }
.area { flex: 1; font-size: 14.5px; font-weight: 700; color: #2B3038; }
.tag { font-size: 10.5px; font-weight: 800; padding: 2px 8px; border-radius: 999px; }
.tag.on { color: #8A6412; background: #FFF8E8; border: 1px solid #F3E2BE; }
.tag.off { color: #5C6672; background: #F1F3F6; border: 1px solid #E1E6ED; }
.r2 { font-size: 12px; color: #7A8494; margin-top: 7px; }
.r3 { display: flex; justify-content: space-between; font-size: 12px; color: #7A8494; margin-top: 3px; }
.who { color: #7A8494; }
.cnt { color: #7A8494; }
.num { color: #F5531C; font-weight: 800; font-size: 13px; }
.acts { display: flex; gap: 8px; margin-top: 9px; }
.act { flex: 1; text-align: center; font-size: 12px; font-weight: 700; color: #7A8494;
  border: 1px dashed #E3E8EF; border-radius: 9px; padding: 6px 0; background: #FAFBFC; }
.act.resume { color: #F5531C; border-color: #FFC9AF; background: #FFF9F6; }
/* ⭐ 删除（2026-10-04 老板要的）：做成红色虚线、比另两个窄一些（次要操作，别抢主操作）*/
.act.del { flex: 0 0 76px; color: #C93A40; border-color: #F2D3D5; background: #FEF6F6; }

/* 空态 */
.empty { text-align: center; padding: 46px 0; }
.e1 { font-size: 13px; color: #8A93A0; }
.e2 { font-size: 11.5px; color: #A6AEBA; margin-top: 6px; }

/* 吸底按钮 */
.bar { position: absolute; left: 0; right: 0; bottom: 0; display: flex; gap: 8px; padding: 10px 12px calc(10px + env(safe-area-inset-bottom));
  background: #fff; border-top: 1px solid #E3E8EF; }
.bigbtn { flex: 1; height: 46px; line-height: 46px; text-align: center; border-radius: 12px; color: #fff;
  font-size: 15.5px; font-weight: 800; background: linear-gradient(135deg,#FF7A3D,#F5531C);
  box-shadow: 0 6px 16px rgba(245,83,28,.3); }
.flex1 { flex: 1.6; }
.half { flex: 1; height: 46px; line-height: 44px; text-align: center; border-radius: 12px;
  border: 1px solid #E3E8EF; background: #fff; color: #2B3038; font-size: 13px; font-weight: 700; }

/* 二级视图标题 */
.head2 { padding: 12px 14px 8px; background: #E7EAF1; }
.h2-t { font-size: 14.5px; font-weight: 800; color: #2B3038; }
.h2-s { font-size: 11.5px; color: #7A8494; margin-top: 4px; }

/* 客户行 */
.cc { background: #fff; border-radius: 12px; padding: 11px 12px; margin-bottom: 9px;
  box-shadow: 0 1px 3px rgba(20,25,35,.06); }
.c-n { font-size: 14px; font-weight: 700; color: #2B3038; }
.c-a { font-size: 11.5px; color: #7A8494; margin-top: 4px; }
.c-m { font-size: 11.5px; margin-top: 5px; }
.ok { color: #16A34A; font-weight: 700; }
