/* 战况地图（2026-09-09 §7.13 老板拍板）
   2026-09-10：底部 Tab 迁移到自定义组件 custom-tab-bar；页面底色与首页统一（切页不再出现底色跳变） */
.page {
  min-height: 100vh; padding-bottom: 200rpx;
  background:
    radial-gradient(120% 55% at 6% -8%, #FFE6D8 0%, rgba(255,230,216,0) 58%),
    radial-gradient(90% 40% at 100% 4%, #E8F1FD 0%, rgba(232,241,253,0) 60%),
    linear-gradient(180deg, #FBFCFE 0%, #EFF3F8 100%);
}

.whead { display: flex; align-items: center; justify-content: space-between; padding: 20rpx 28rpx 8rpx; }
.wh-t { font-size: 36rpx; font-weight: 800; }
.wh-s { font-size: 22rpx; color: var(--sub); margin-top: 4rpx; }
.wh-bell { background: #FFF; border-radius: 999rpx; padding: 12rpx 20rpx; font-size: 26rpx; box-shadow: 0 2rpx 10rpx rgba(31,36,48,.08); color: #E5484D; font-weight: 700; }
.wh-bell.off { color: var(--sub); }

/* 数字胶囊带（与首页同款） */
.boss-stats { display: flex; gap: 10rpx; margin: 12rpx 28rpx 16rpx; }
.bs { flex: 1; background: #FFF; border-radius: 18rpx; padding: 20rpx 0; text-align: center; box-shadow: 0 2rpx 10rpx rgba(31,36,48,.05); }
.bs-n { font-size: 40rpx; font-weight: 800; color: #1F2430; line-height: 1.1; }
.bs-l { font-size: 22rpx; color: #66707A; margin-top: 6rpx; }
.c-blue { color: #2F80ED; }
.c-orange { color: #F5531C; }
.c-red { color: #E5484D; }

/* 地图 */
.wmap-wrap { position: relative; margin: 0 28rpx; overflow: hidden; border-radius: 20rpx; }
/* ⚠️ 2026-09-25：高度**多出 40rpx** —— 多出来的底部被 .wmap-wrap 的 overflow:hidden 裁掉，
   而腾讯地图的 logo + 版权/审图号就在那一块（官方无隐藏接口，"裁剪"是社区通用做法）。
   圆角/阴影从地图挪到 wrapper 上，否则裁完底部两个角会变方。 */
.wmap { width: 100%; height: calc(55vh + 40rpx); }
.wlegend { position: absolute; left: 16rpx; bottom: 16rpx; background: rgba(255,255,255,.95); border-radius: 14rpx; padding: 12rpx 16rpx; display: flex; gap: 16rpx; font-size: 20rpx; color: #333A44; }
.wlegend .lg { display: flex; align-items: center; gap: 6rpx; }
.wlegend .dot { width: 16rpx; height: 16rpx; border-radius: 50%; }
.wonly { position: absolute; left: 16rpx; top: 16rpx; background: #FFF; border-radius: 999rpx; padding: 10rpx 20rpx; font-size: 22rpx; font-weight: 600; box-shadow: 0 2rpx 10rpx rgba(31,36,48,.12); }
/* 小圆钮（2026-09-09 老板定：📍我的位置/↻刷新，地图右上角横排，同任务地图） */
.wctrl { position: absolute; right: 16rpx; top: 16rpx; display: flex; flex-direction: row; gap: 12rpx; z-index: 12; }
.wfab { width: 64rpx; height: 64rpx; border-radius: 50%; background: rgba(255,255,255,.96); box-shadow: 0 3px 10rpx rgba(31,36,48,.16); display: flex; align-items: center; justify-content: center; font-size: 30rpx; }
.wfab.spin { animation: wspin 0.8s linear; } /* 刷新旋转动效（2026-09-09） */
@keyframes wspin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

.center-box { text-align: center; color: var(--sub); font-size: 24rpx; margin-top: 40rpx; }

/* 今日动态流 */
.wsec-t { margin: 28rpx 28rpx 12rpx; font-size: 28rpx; font-weight: 700; }
.wsec-n { font-size: 22rpx; color: var(--sub); font-weight: 400; margin-left: 10rpx; }
.wflow { margin: 0 28rpx; }
.wf { display: flex; align-items: center; gap: 16rpx; background: #FFF; border-radius: 16rpx; padding: 18rpx 20rpx; margin-bottom: 12rpx; box-shadow: 0 2rpx 8rpx rgba(31,36,48,.04); }
.wf-ic { width: 44rpx; height: 44rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 22rpx; color: #FFF; flex-shrink: 0; }
.wf.going .wf-ic { background: #2F80ED; }
.wf.done .wf-ic { background: #16A34A; }
.wf-tx { flex: 1; min-width: 0; }
.wf-l1 { font-size: 26rpx; font-weight: 700; }
.wf-l2 { font-size: 22rpx; color: var(--sub); margin-top: 4rpx; }
.wf-t { font-size: 22rpx; color: var(--sub); }

/* 业务员抽屉卡（底部让位给胶囊 Tab：28rpx 离底 + 128rpx 高 + 24rpx 间距） */
.drawer { position: fixed; left: 20rpx; right: 20rpx; bottom: 180rpx; background: #FFF; border-radius: 24rpx; padding: 24rpx; box-shadow: 0 12rpx 40rpx rgba(31,36,48,.25); z-index: 20; }
.dr-head { display: flex; align-items: center; gap: 12rpx; }
.dr-dot { width: 20rpx; height: 20rpx; border-radius: 50%; }
.dr-name { font-size: 32rpx; font-weight: 800; }
.dr-state { font-size: 24rpx; font-weight: 700; }
.dr-x { margin-left: auto; color: var(--sub); font-size: 28rpx; padding: 4rpx 8rpx; }
.dr-row { font-size: 26rpx; color: #333A44; margin-top: 14rpx; }
.dr-sub { color: var(--sub); font-size: 22rpx; }
.dr-btns { display: flex; gap: 16rpx; margin-top: 20rpx; }
.drb { flex: 1; height: 76rpx; border-radius: 14rpx; background: #F0F2F5; color: #333A44; display: flex; align-items: center; justify-content: center; font-size: 26rpx; font-weight: 600; }
.drb.main { background: linear-gradient(135deg,#FF7A3D,#F5531C); color: #FFF; }

/* 四栏底部导航（2026-09-10 改与首页同款悬浮胶囊，位置口径同首页：离底 14px = 28rpx） */
.tabbar {
  position: fixed; left: 28rpx; right: 28rpx; bottom: 28rpx; height: 128rpx; border-radius: 44rpx; display: flex; align-items: center;
  background: linear-gradient(180deg, rgba(255,255,255,.99), rgba(248,250,253,.95));
  box-shadow: 0 0 0 1px rgba(23,30,44,.05), 0 28rpx 60rpx -20rpx rgba(23,30,44,.38), inset 0 1rpx 0 rgba(255,255,255,.95);
  z-index: 30;
}
.tb { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6rpx; font-size: 22rpx; color: #88909A; font-weight: 700; }
.tb .pill { display: flex; flex-direction: column; align-items: center; gap: 4rpx; padding: 14rpx 30rpx; border-radius: 32rpx; }
.tb .tic { font-size: 38rpx; line-height: 1; }
.tb.on { color: var(--primary-deep); }
.tb.on .pill { color: #fff; background: linear-gradient(180deg, #FF8A50, #F5531C); box-shadow: 0 20rpx 40rpx -14rpx rgba(245,83,28,.75), inset 0 1rpx 0 rgba(255,255,255,.5); }

/* ===== 「聚火地图」地图标识（2026-09-25 老板定：手机端地图也要去掉腾讯 logo/版本号、换成这个） =====
   logo 已被 .wmap-wrap 的"裁剪法"裁掉 → badge 不需要不透明底（原 cover-view 胶囊版已作废），
   用「橙字白描边」，指南针用「圆环 + 旋转 45° 的小方块」拼，白边靠多层 text-shadow。
   ⚠️ 位置（2026-09-25 老板定，最终版）：**贴住地图卡片的右下角**（right:0 / bottom:0）——
     腾讯地图的 logo + 版权/审图号就在**右下角**，白底 badge 直接把它们**压住**（与 .wmap-wrap 的裁剪法双保险）。
     因为贴角，只保留**左上圆角**；右下两角跟着卡片走（卡片本身 border-radius:20rpx + overflow:hidden）。 */
.jh-badge { position: absolute; right: 0; bottom: 0; z-index: 99; pointer-events: none;
  display: flex; align-items: flex-end; gap: 6rpx;
  background: rgba(255,255,255,.94); border-radius: 16rpx 0 0 0; padding: 5rpx 12rpx 6rpx 10rpx; }
.jh-compass { width: 13px; height: 13px; border: 2px solid #F5531C; border-radius: 50%; margin-right: 3px;
  display: flex; align-items: center; justify-content: center; }
.jh-needle { width: 5px; height: 5px; background: #F5531C; transform: rotate(45deg); }
.jh-word { font-size: 12px; font-weight: 800; letter-spacing: -0.2px; line-height: 1; color: #F5531C; }
