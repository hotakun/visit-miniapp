/* 地图页（2026-09-08 二期核心） */
.page { position: relative; width: 100vw; height: 100vh; overflow: hidden; }
.m-wrap { position: relative; width: 100%; height: 100%; }
.m { width: 100%; height: 100%; }
.center-box { position: absolute; left: 50%; top: 45%; transform: translate(-50%, -50%); color: var(--sub); font-size: 14px; font-weight: 400; text-align: center; white-space: pre-line; }

/* 地图小圆钮（2026-09-09 老板定：横幅条下方靠右横排——🚦路况/📍我的位置/↻刷新，纯图标无文字） */
.m-ctrl { position: absolute; right: 14px; top: 104px; display: flex; flex-direction: row; gap: 8px; z-index: 12; }
.mfab { width: 32px; height: 32px; border-radius: 50%; background: rgba(255,255,255,.96); box-shadow: 0 3px 10px rgba(31,36,48,.16); display: flex; align-items: center; justify-content: center; font-size: 15px; }
.mfab.on { background: var(--blue); } /* 路况开启态 */

/* 天页签 */
.daybar { position: absolute; top: 14px; left: 0; right: 0; display: flex; justify-content: center; gap: 8px; z-index: 10; }
.dtag { padding: 7px 16px; border-radius: 999px; background: rgba(255,255,255,.92); color: var(--sub); font-size: 13px; font-weight: 400; box-shadow: 0 2px 10px rgba(31,36,48,.14); }
.dtag.on { background: var(--primary); color: #fff; }
/* 第 6 天起纯数字圆标（老板 2026-09-08 定） */
.dtag.dot { width: 28px; height: 28px; padding: 0; display: flex; align-items: center; justify-content: center; font-size: 12px; border-radius: 50%; }

/* 下一家引导条（2026-09-09 老板定：收矮——紧凑高度，不臃肿） */
.nextbar { position: absolute; left: 14px; right: 14px; top: 62px; display: flex; align-items: center; gap: 10px; background: #fff; border-radius: 12px; padding: 6px 12px; box-shadow: 0 4px 16px rgba(31,36,48,.16); z-index: 10; }
.ntxt { flex: 1; display: flex; align-items: center; gap: 6px; min-width: 0; }
.nlab { font-size: 12px; font-weight: 400; color: var(--primary-deep); flex-shrink: 0; }
.nname { font-size: 13px; font-weight: 800; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ndist { font-size: 11.5px; color: var(--sub); flex-shrink: 0; }
.nbtn { display: flex; align-items: center; background: var(--blue-tint); color: var(--blue); border: 0.5rpx solid rgba(47,128,237,.28); font-size: 11px; font-weight: 400; padding: 2px 9px; border-radius: 999px; flex-shrink: 0; line-height: 1.4; }

/* 底部客户卡 */
.custcard { position: absolute; left: 14px; right: 14px; bottom: 26px; background: #fff; border-radius: 16px; padding: 14px 16px; box-shadow: 0 8px 24px rgba(31,36,48,.22); z-index: 10; }
.cc-close { position: absolute; top: 10px; right: 12px; width: 22px; height: 22px; line-height: 21px; text-align: center; background: #F0F2F5; color: var(--sub); border-radius: 50%; font-size: 11px; }
.cc-name { font-size: 16px; font-weight: 800; padding-right: 28px; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.cc-st { font-size: 11px; font-weight: 400; padding: 3px 10px; border-radius: 999px; background: #FFF4EE; color: var(--primary-deep); }
.cc-st.v { background: #F0F9F2; color: var(--green); }
.cc-st.o { background: var(--blue-tint); color: var(--blue); }
.cc-sub { margin-top: 5px; font-size: 12.5px; color: var(--sub); font-weight: 400; }
.cc-btns { display: flex; gap: 10px; margin-top: 12px; }
.ccb { flex: 1; text-align: center; padding: 11px 0; border-radius: 12px; font-size: 14px; font-weight: 400; }
.ccb.nav { background: var(--blue); color: #fff; }
.ccb.go { background: var(--primary); color: #fff; }
